[Unit]
Description=Start appliance playback and ramp the volume
Documentation=file:/etc/atibi.conf
Requires=atibi-cliamp.service
After=atibi-cliamp.service
RequiresMountsFor=/data

[Service]
Type=oneshot
RemainAfterExit=yes
User=pi
Group=pi
Environment=HOME=/home/pi
Environment=LANG=C.UTF-8
ExecStart=/usr/local/bin/atibi-play
TimeoutStartSec=120
# The boot waits for the races it knows about (clock, route); this is
# the backstop for the rest, and the script is idempotent.
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atibi-play

[Install]
WantedBy=atibi.target
