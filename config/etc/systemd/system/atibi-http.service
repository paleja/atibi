[Unit]
Description=atibi LAN control server (web page on the appliance's player)
Documentation=file:/data/cliamp/cliamp.log
After=atibi-cliamp.service
RequiresMountsFor=/data

[Service]
Type=simple
User=pi
Group=pi
Environment=HOME=/home/pi
Environment=LANG=C.UTF-8
ExecStart=/usr/local/bin/atibi-http
Restart=always
RestartSec=2
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atibi-http

[Install]
WantedBy=atibi.target
