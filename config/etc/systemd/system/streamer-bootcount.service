[Unit]
Description=Count boot attempts and roll back a boot config that will not come up
Documentation=file:/etc/streamer.conf
# As early as /data allows: the point is to notice a bad boot before the rest of
# the boot has had the chance to fail. Being wanted by basic.target puts it in
# the earliest phase where a normal unit may run, and RequiresMountsFor= asks
# for data.mount and orders after it. What used to be here, Before=basic.target,
# is an ordering cycle: ordinary units are already ordered after basic.target by
# their implicit dependencies, and systemd then drops one of the two edges at
# boot, at random. Being started before anything that touches the speakers is
# the actual requirement, and that is said directly.
# Both partitions this script reads and writes have to be mounted: /data holds
# the counter, /boot/firmware holds the configuration being counted.
RequiresMountsFor=/data /boot/firmware
Before=streamer-cliamp.service streamer-play.service
ConditionPathExists=/data/.ready

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/streamer-bootcount
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamer-bootcount

[Install]
WantedBy=basic.target
