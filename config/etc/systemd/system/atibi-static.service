[Unit]
Description=Hold the wired interface at the address the appliance saved
Documentation=file:/etc/atibi.conf
RequiresMountsFor=/data
Before=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# No User=: NetworkManager reads its configuration as root.
ExecStart=/usr/local/bin/atibi-static
TimeoutStartSec=10

[Install]
# Wanted by NetworkManager itself, so the file is in place the first moment
# NM looks at it, on a boot and on a restart of NM.
WantedBy=NetworkManager.service
