[Unit]
Description=cliamp headless player daemon
Documentation=file:/data/cliamp/cliamp.log
After=network.target
RequiresMountsFor=/data

[Service]
Type=simple
User=pi
Group=pi
Environment=HOME=/home/pi
# System services get no locale from PAM; without this, non-ASCII station and
# track names come out mangled in the journal.
Environment=LANG=C.UTF-8
ExecStart=/usr/local/bin/streamer-daemon
# always, not on-failure: cliamp treats SIGTERM as a clean shutdown and exits
# 0, so a stray `pkill cliamp` (easy to hit when a second TUI needs killing)
# would otherwise leave the appliance silent until reboot. Only deliberate
# stops (streamer reset) use systemctl stop, which always wins over this.
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamer-cliamp

[Install]
WantedBy=streamer.target
