[Unit]
Description=cliamp headless player daemon
Documentation=file:/data/cliamp/cliamp.log
# A player needs no address to start; the boot waits for the route itself,
# and retries the load call, which a young daemon refuses (see atibi.boot).
RequiresMountsFor=/data

[Service]
Type=simple
User=pi
Group=pi
Environment=HOME=/home/pi
Environment=LANG=C.UTF-8
ExecStart=/usr/local/bin/atibi-daemon
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atibi-cliamp

[Install]
WantedBy=atibi.target
