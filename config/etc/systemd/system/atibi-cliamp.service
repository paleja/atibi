[Unit]
Description=cliamp headless player daemon
Documentation=file:/data/cliamp/cliamp.log
# network.target is up before any address exists; online.target returns once
# the DHCP lease is in (without it, the first m3u fetch is
# "network is unreachable").
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
User=pi
Group=pi
Environment=HOME=/home/pi
Environment=LANG=C.UTF-8
ExecStart=/usr/local/bin/atibi-daemon
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atibi-cliamp

[Install]
WantedBy=atibi.target
