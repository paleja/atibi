[Unit]
Description=Record where playback has got to
Documentation=file:/etc/streamer.conf
Requires=streamer-cliamp.service
After=streamer-cliamp.service
RequiresMountsFor=/data

[Service]
Type=oneshot
User=pi
Group=pi
Environment=HOME=/home/pi
Environment=LANG=C.UTF-8
ExecStart=/usr/local/bin/streamer-save
TimeoutStartSec=40
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamer-save
