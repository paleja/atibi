[Unit]
Description=Record this boot config as known-good
Documentation=file:/etc/streamer.conf
After=basic.target streamer-bootcount.service
# It writes to /data, and on the very first boot /data does not exist yet:
# without these two lines the unit would try to build the directory tree on the
# read-only root. The first real known-good record is then written by the
# second boot, which is the one that proves the layout worked.
RequiresMountsFor=/data /boot/firmware
ConditionPathExists=/data/.ready

[Service]
Type=oneshot
ExecStart=/usr/local/bin/streamer-booted
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamer-booted

[Install]
WantedBy=multi-user.target
