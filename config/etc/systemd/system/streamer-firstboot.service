[Unit]
Description=Set up and grow the streamer data partition
Documentation=file:/etc/streamer.conf
# Runs before /data is mounted: resizing a partition and an ext4 is something
# nothing else may be holding. It is not a one-shot and has no condition on the
# provisioning marker - the partition table can only be written in a boot where
# the kernel still sees the old geometry, so the filesystem has to catch up in
# the boot after that. Every check it makes is cheap and reads current facts,
# so a mature boot runs it, finds the sizes agree, and leaves.
# ConditionFirstBoot is not used either: it is tied to an uninitialised /etc,
# and this box has already consumed that first boot before the appliance ever
# starts.
DefaultDependencies=no
After=systemd-udevd.service local-fs-pre.target
Before=local-fs.target data.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/streamer-firstboot
TimeoutStartSec=600
# The appliance has no screen of its own, but if one is attached while the card
# is being brought up for the first time, this is the output worth seeing.
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=streamer-firstboot

[Install]
WantedBy=sysinit.target
