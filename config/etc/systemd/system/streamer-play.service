[Unit]
Description=Start appliance playback and ramp the volume
Documentation=file:/etc/streamer.conf
Requires=streamer-cliamp.service
After=streamer-cliamp.service
RequiresMountsFor=/data

[Service]
Type=oneshot
RemainAfterExit=yes
User=pi
Group=pi
Environment=HOME=/home/pi
Environment=LANG=C.UTF-8
ExecStart=/usr/local/bin/streamer-play
TimeoutStartSec=120
# The boot waits for the races it knows about (clock, route); this is
# the backstop for the rest, and the script is idempotent.
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamer-play

[Install]
WantedBy=streamer.target
