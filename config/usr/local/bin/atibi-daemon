#!/bin/sh
# Started by atibi-cliamp.service. Never starts playback: only
# atibi-play starts audio, which keeps the floor and the ramp unbypassable.
set -eu

. /etc/atibi.conf

# cliamp needs ffmpeg for AAC/Opus/ALAC/HLS streams; /data/bin first, so a
# newer binary can be dropped on the writable partition without a remount.
PATH=/data/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# The codec's 'Digital' control wakes at 0 dB every power-on, so it is set
# absolutely: 100% first, then the dB, so a restart cannot stack the trim.
gain=${ATIBI_DAC_GAIN:-}
case $gain in ''|0) gain= ;; esac
if [ -n "$gain" ]; then
    card=0
    while [ "$card" -lt 8 ]; do
        if amixer -c "$card" scontrols 2>/dev/null |
                grep -q "^Simple mixer control 'Digital',"; then
            trim="${gain#-}dB"
            case $gain in -*) trim="$trim-" ;; *) trim="$trim+" ;; esac
            if amixer -q -c "$card" sset 'Digital' 100% >/dev/null 2>&1 &&
               amixer -q -c "$card" sset 'Digital' "$trim" >/dev/null 2>&1; then
                echo "codec volume on card $card pinned to $gain dB"
            else
                echo "card $card has a codec volume that refused the $gain dB trim" >&2
            fi
            break
        fi
        card=$((card + 1))
    done
fi

exec cliamp --daemon \
    --vol "$ATIBI_VOL_FLOOR" \
    --buffer-ms "$ATIBI_BUFFER_MS" \
    --sample-rate "$ATIBI_SAMPLE_RATE"
