#!/bin/sh
# streamer-booted - this boot got as far as the multi-user phase, so the boot
# configuration in /boot/firmware works. Record it as last-good and clear the
# failure counter that streamer-bootcount maintains.
set -eu

. /etc/streamer.conf

log_boot() { # log_boot <one line>
    /usr/local/bin/streamer-bootlog "$1"
}

boot_dir=/boot/firmware

mkdir -p "$STREAMER_LASTGOOD"

cp "$boot_dir/config.txt" "$STREAMER_LASTGOOD/config.txt.tmp"
mv -f "$STREAMER_LASTGOOD/config.txt.tmp" "$STREAMER_LASTGOOD/config.txt"
if [ -f "$boot_dir/cmdline.txt" ]; then
    cp "$boot_dir/cmdline.txt" "$STREAMER_LASTGOOD/cmdline.txt.tmp"
    mv -f "$STREAMER_LASTGOOD/cmdline.txt.tmp" "$STREAMER_LASTGOOD/cmdline.txt"
fi

# Hashed the same way streamer-bootcount hashes the live files, from the same
# inputs, or the two values would never line up and rollback would compare
# apples with pears. cmdline.txt is optional in the same two places.
hash=$({ cat "$boot_dir/config.txt"
         [ -f "$boot_dir/cmdline.txt" ] && cat "$boot_dir/cmdline.txt"; } |
    sha256sum | cut -d' ' -f1)
printf '%s\n' "$hash" >"$STREAMER_LASTGOOD/hash.tmp"
mv -f "$STREAMER_LASTGOOD/hash.tmp" "$STREAMER_LASTGOOD/hash"

# attempt=0 plus the matching config: the next boot of this same configuration
# counts as attempt 1, and only a run that fails again from here starts a count.
printf 'attempt=0\nconfig=%s\n' "$hash" >"$STREAMER_ATTEMPT.tmp"
mv -f "$STREAMER_ATTEMPT.tmp" "$STREAMER_ATTEMPT"
sync
log_boot "boot config $(printf '%.16s' "$hash") reached multi-user, counter reset"

echo "boot config $hash is good" >&2
