#!/bin/sh
# streamer-play - bring up playback for this boot, then ramp the volume.
# Started by streamer-play.service, and the only thing that starts audio, so the
# floor and the ramp cannot be bypassed.
set -eu

. /etc/streamer.conf
# A card flashed before this knob existed keeps the same default path.
STREAMER_PLAY_NOW=${STREAMER_PLAY_NOW:-/run/streamer/play-now}

log_boot() { # log_boot <one line>
    /usr/local/bin/streamer-bootlog "$1"
}

mode=last
kind="$STREAMER_START_KIND"
target="$STREAMER_START_TARGET"
provider=""
saved_vol=""
# What plays next boot and how loud.
last() { sed -n "s/^$1=//p" "$STREAMER_STATE" 2>/dev/null | tail -n 1; }
if [ -f "$STREAMER_STATE" ]; then
    # Last line wins per key. The streamer command never writes a key twice; a
    # hand-edited file can, and "-30\n-99" would break every comparison below.
    mode=$(last mode)
    kind=$(last kind)
    target=$(last target)
    provider=$(last provider)
    saved_vol=$(last volume)
fi
[ -n "$mode" ] || mode=last
[ -n "$kind" ] || kind=url
case "$saved_vol" in ''|*[!0-9.-]*) saved_vol= ;; esac

# A play request for this session only: `streamer station <url>` without --save
# wrote it to tmpfs, so a reboot cannot find it and it says nothing about what the
# next boot loads. It wins over the saved record for this start, and an explicit
# request plays even in stop mode, which means quiet after the next boot.
req_last() { sed -n "s/^$1=//p" "$STREAMER_PLAY_NOW" 2>/dev/null | tail -n 1; }
ad_hoc=""
if [ -f "$STREAMER_PLAY_NOW" ]; then
    ad_kind=$(req_last kind)
    ad_target=$(req_last target)
    if [ -n "$ad_kind" ] && [ -n "$ad_target" ]; then
        kind=$ad_kind
        target=$ad_target
        provider=$(req_last provider)
        mode=last
        ad_hoc=1
    else
        echo "one-shot play request names no kind or target: ignoring it" >&2
    fi
fi
[ "$mode" = stop ] && { echo "appliance is in stop mode, staying quiet"; log_boot "stop mode, nothing started"; exit 0; }
[ -n "$target" ] || { echo "nothing to play" >&2; log_boot "FAIL no target to play"; exit 1; }

# The daemon starts in parallel; wait for its IPC socket.
sock="${HOME:-/home/pi}/.config/cliamp/cliamp.sock"
i=0
while [ ! -S "$sock" ]; do
    i=$((i + 1))
    [ "$i" -gt "$((STREAMER_SOCKET_WAIT * 4))" ] && {
        echo "cliamp socket never appeared: $sock" >&2
        log_boot "FAIL no cliamp socket after ${STREAMER_SOCKET_WAIT}s"
        exit 1
    }
    sleep 0.25
done

# A stream needs name resolution. Rather than pulling in network-online.target and
# its two-second stall, check the one thing the target actually needs.
host=$(printf '%s' "$target" | sed -n 's#^[a-zA-Z]*://\([^/:]*\).*#\1#p')
need_network() { # does this target have to reach a service somewhere?
    [ -n "$host" ] && return 0
    # provider playlists, albums and single tracks are bare ids with no hostname,
    # yet all of them are fetched across the network.
    case "$kind" in provider|album|track) return 0 ;; esac
    return 1
}
net_ready() { # can this target be reached yet?
    if [ -n "$host" ]; then
        getent hosts "$host" >/dev/null 2>&1
    else
        # A provider target is a bare id: no hostname for the check above, yet it
        # is fetched across the network.
        # Which host the service needs is cliamp's business; either way it needs
        # a route and an address, which is what `ip route get` answers.
        ip route get 1.1.1.1 >/dev/null 2>&1
    fi
}
if need_network; then
    i=0
    until net_ready; do
        i=$((i + 1))
        if [ "$i" -eq 1 ]; then
            # journald is volatile here, so a boot that had to wait says so once.
            # A provider target names no host, so say what is waited for: a route.
            [ -n "$host" ] && waiting="to resolve $host" || waiting="for a route"
            echo "network not up yet, waiting up to ${STREAMER_NET_WAIT}s $waiting" >&2
            log_boot "WARN network not up, waiting ${STREAMER_NET_WAIT}s for $kind $target"
        fi
        [ "$i" -gt "$((STREAMER_NET_WAIT * 4))" ] && {
            if [ -n "$host" ]; then
                echo "cannot resolve $host" >&2
                log_boot "FAIL cannot resolve $host for $kind $target"
            else
                echo "no route to any address after ${STREAMER_NET_WAIT}s" >&2
                log_boot "FAIL no network route for $kind $target"
            fi
            exit 1
        }
        sleep 0.25
    done
fi

# A Pi has no RTC battery: after a power cut the clock starts at the image build
# date, and every TLS handshake before the first NTP sync fails as "certificate
# is not yet valid". So an https target waits for timesyncd's flag file - bounded,
# because with no NTP reachable the box should still try to play.
case "$target" in
    https://*)
        sync_flag=${STREAMER_TIME_SYNC_FLAG:-/run/systemd/timesync/synchronized}
        i=0
        while [ ! -f "$sync_flag" ]; do
            i=$((i + 1))
            [ "$i" -gt $((STREAMER_SYNC_WAIT * 2)) ] && {
                echo "clock not synchronized after ${STREAMER_SYNC_WAIT}s: https certificates will be checked against the wrong date" >&2
                log_boot "WARN clock unsynced after ${STREAMER_SYNC_WAIT}s"
                break
            }
            sleep 0.5
        done
        ;;
esac

status() { cliamp status --json 2>/dev/null || true; }
# status --json is pretty-printed and spells some keys twice: the row number sits
# inside "track" as well as at the top level. So the search is line-based, allows
# a space after the colon, and keeps the last hit.
# A compact-only pattern made every pick come back empty, which started the ramp
# from an assumed level and left the two guards below inert.
pick() { # pick <json> <key> : that key's number, sign included
    printf '%s' "$1" |
        sed -n "s/.*\"$2\": *\(-\{0,1\}[0-9][0-9.]*\).*/\1/p" | tail -n 1
}
jstr() { # jstr <json> <key> : that key's string
    printf '%s' "$1" | sed -n 's/.*"'"$2"'": *"\([^"]*\)".*/\1/p' | tail -n 1
}

# Hard floor, set before anything can reach the speakers. The daemon started at
# it already; setting it again covers a daemon that restored an old session itself.
if ! cliamp volume "$STREAMER_VOL_FLOOR"; then
    echo "could not set the volume floor of $STREAMER_VOL_FLOOR dB" >&2
    log_boot "FAIL volume floor $STREAMER_VOL_FLOOR"
    exit 1
fi

case "$kind" in
    playlist)
        # The same name the --playlist flag and the TUI use; cliamp load waits up
        # to five minutes for a big playlist, hence this unit's TimeoutStartSec.
        if ! cliamp load "$target"; then
            echo "could not load playlist: $target" >&2
            log_boot "FAIL load '$target'"
            exit 1
        fi
        ;;
    url|file)
        # NOT `cliamp queue <url>`: a live daemon already has the radio channels
        # loaded and queue only appends, so play would start row 0, a different
        # channel. url.load with play set starts the row it adds. No jq on the
        # card, hence the hand-escaped JSON.
        esc=$(printf '%s' "$target" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
        if ! cliamp remote call url.load --params "{\"path\":\"$esc\",\"play\":true}" --wait; then
            echo "could not start: $target" >&2
            log_boot "FAIL url.load $target"
            exit 1
        fi
        ;;
    provider)
        # A provider playlist is not a file on disk, so `cliamp load` cannot find it:
        # provider.load pulls it from the service by id and starts playing what it
        # loads, which is why no play call follows. Without this branch a Tidal
        # playlist booted to silence.
        if [ -z "$provider" ]; then
            # kind=provider with no provider named can never be answered.
            echo "kind=provider with no provider named in $STREAMER_STATE" >&2
            log_boot "FAIL provider playlist with no provider: $target"
            exit 1
        fi
        esc_p=$(printf '%s' "$provider" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
        esc_t=$(printf '%s' "$target" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
        if ! cliamp remote call provider.load \
             --params "{\"provider\":\"$esc_p\",\"playlist\":\"$esc_t\"}" --wait; then
            echo "could not load $provider playlist: $target" >&2
            log_boot "FAIL provider.load $provider $target"
            exit 1
        fi
        ;;
    album|track)
        # What tapping an album hit, or one track, on the phone wrote down:
        # provider.load_album expands an album into its real rows and starts playing
        # them; a single track goes back through track.play as a row rebuilt from
        # the state file. Both need the service, so the route wait covers them.
        # The provider name becomes a JSON key and a path scheme, so a hand-edited
        # state file cannot name it with quotes or spaces in it.
        case "$provider" in
            *[!a-z0-9-]*|'')
                echo "kind=$kind with no usable provider name in $STREAMER_STATE: '$provider'" >&2
                log_boot "FAIL $kind target with no provider: $target"
                exit 1
                ;;
        esac
        esc_p=$(printf '%s' "$provider" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
        esc_t=$(printf '%s' "$target" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
        if [ "$kind" = album ]; then
            if ! cliamp remote call provider.load_album \
                 --params "{\"provider\":\"$esc_p\",\"album\":\"$esc_t\"}" --wait; then
                echo "could not load $provider album: $target" >&2
                log_boot "FAIL provider.load_album $provider $target"
                exit 1
            fi
        else
            # cliamp 2.4.1 cannot fetch a track by id, so the row's display strings
            # ride in the state file and are put back here: they decide what "now
            # playing" shows, and a track saved without them still plays, unnamed.
            esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
            row="{\"path\":\"$esc_p://track/$esc_t\",\"stream\":true,\"provider_meta\":{\"$esc_p.id\":\"$esc_t\"}"
            # Whichever record this start was asked for holds the strings.
            if [ -n "$ad_hoc" ]; then
                t_title=$(req_last title); t_artist=$(req_last artist); t_album=$(req_last album)
            else
                t_title=$(last title); t_artist=$(last artist); t_album=$(last album)
            fi
            if [ -n "$t_title" ]; then row="$row,\"title\":\"$(esc "$t_title")\""; fi
            if [ -n "$t_artist" ]; then row="$row,\"artist\":\"$(esc "$t_artist")\""; fi
            if [ -n "$t_album" ]; then row="$row,\"album\":\"$(esc "$t_album")\""; fi
            row="$row}"
            # The answer is captured, not just checked: it says where the row landed,
            # and if the transport has not flipped to playing
            if ! resp=$(cliamp remote call track.play --params "{\"track\":$row}" --wait); then
                echo "could not play $provider track: $target" >&2
                log_boot "FAIL track.play $provider $target"
                exit 1
            fi
            play_index=$(printf '%s' "$resp" |
                sed -n 's/.*"index": *\([0-9][0-9]*\).*/\1/p' | tail -n 1)
            case "$play_index" in ''|*[!0-9]*) play_index= ;; esac
        fi
        ;;
    *) echo "unknown state kind: $kind" >&2; log_boot "FAIL unknown kind $kind"; exit 1 ;;
esac

# url.load with play starts the row it adds, provider.load starts playing when it
# can, a playlist load only fills the list: ask only if nothing is running, so a
# boot never restarts a track that already began.
# Row 0, never a remembered row - the appliance records what to play, not where
# it got to. One exception: kind=track is a row appended to the loaded list, so
# the row track.play reported is the one to start if the transport has not begun
if [ "$(jstr "$(status)" state)" != playing ]; then
    start_at=${play_index:-0}
    if ! cliamp remote call queue.play --params "{\"index\":$start_at}" --wait >/dev/null 2>&1; then
        echo "nothing would play from $kind $target" >&2
        log_boot "FAIL queue.play index=$start_at for $kind $target"
        exit 1
    fi
fi

i=0
while :; do
    json=$(status)
    # Not a sed on one key: status --json can report other things with a state
    # of their own, and "playing" anywhere is the signal that audio is running.
    case "$json" in *'"state":"playing"'*|*'"state": "playing"'*) break ;; esac
    i=$((i + 1))
    [ "$i" -gt $((STREAMER_PLAY_WAIT * 2)) ] && {
        state=$(jstr "$json" state)
        echo "no playback within ${STREAMER_PLAY_WAIT}s (state=${state:-unknown})" >&2
        log_boot "FAIL no playing state within ${STREAMER_PLAY_WAIT}s"
        exit 1
    }
    sleep 0.5
done

# The request is spent: a later restart of this unit goes back to what the
# listener saved. It is kept when the start failed, so the unit's own retry
# replays the same request rather than a different thing.
[ -n "$ad_hoc" ] && rm -f "$STREAMER_PLAY_NOW"

# Where the ramp ends: the level the last session left, or the configured default,
# clamped - the floor has to be the last word, so a stale level can never make
# the first sample loud. A saved level at or below the floor is a parked control,
# not a preference: it falls back to the default and says so. For a quiet box,
# use `streamer stop`.
level=${saved_vol:-}
if [ -z "$level" ]; then
    level=$STREAMER_VOL_TARGET
    echo "no saved volume, ramping to the default $level dB"
elif awk -v l="$level" -v f="$STREAMER_VOL_FLOOR" 'BEGIN{ exit (l+0 <= f+0) ? 0 : 1 }'; then
    echo "saved volume $level dB is at or below the $STREAMER_VOL_FLOOR dB floor, treating it as parked: ramping to $STREAMER_VOL_TARGET"
    log_boot "saved volume $level at the floor, using $STREAMER_VOL_TARGET"
    level=$STREAMER_VOL_TARGET
fi
level=$(awk -v l="$level" -v f="$STREAMER_VOL_FLOOR" -v h="$STREAMER_VOL_MAX" \
    'BEGIN{ if (l+0 < f+0) l=f+0; if (l+0 > h+0) l=h+0; printf "%g", l }')

# Ramp: nothing jumps. The amp's relay is closed by now and a step is the one
# thing it could not absorb. Two guards keep the ramp inside the boot:
# a level that never moves means the output device will not go where asked,
# and the step budget caps the ramp either way.
sleep "$STREAMER_RAMP_START"
now=$(pick "$(status)" volume)
[ -n "$now" ] || now=$STREAMER_VOL_FLOOR
steps=0
while :; do
    below=$(awk -v n="$now" -v t="$level" 'BEGIN{ print (n+0 < t+0 - 0.01) ? 1 : 0 }')
    [ "$below" = 1 ] || break

    step=$(awk -v n="$now" -v t="$level" -v s="$STREAMER_RAMP_STEP" \
        'BEGIN{ d=t-n; if (s+0 > d) s=d; printf "%g", s }')
    cliamp remote call volume.adjust --params "{\"value\":$step}" --wait >/dev/null 2>&1 || break
    expected=$(awk -v n="$now" -v s="$step" 'BEGIN{ printf "%g", n+s }')

    # A level more than one step off where this ramp left it was set elsewhere:
    # theirs wins, and the ramp stops.
    after=$(pick "$(status)" volume)
    if [ -n "$after" ]; then
        moved=$(awk -v a="$after" -v e="$expected" -v s="$step" \
            'BEGIN{ d=a-e; if (d<0) d=-d; print (d > s+0.02) ? 1 : 0 }')
        if [ "$moved" = 1 ]; then
            echo "volume was set elsewhere to $after dB, ramp stops"
            log_boot "volume set elsewhere to $after dB, ramp stops"
            now=$after
            break
        fi
        if awk -v a="$after" -v n="$now" \
            'BEGIN{ d=a-n; if (d<0) d=-d; exit (d < 0.01) ? 0 : 1 }'; then
            echo "volume is not moving past $after dB, ramp stops" >&2
            log_boot "volume stuck at $after dB, ramp stops"
            now=$after
            break
        fi
        now=$after
    else
        now=$expected
    fi

    steps=$((steps + 1))
    if [ "$steps" -ge "$STREAMER_RAMP_MAX_STEPS" ]; then
        echo "ramp used its whole budget at $now dB, giving up" >&2
        log_boot "ramp budget of $steps steps exhausted at $now dB"
        break
    fi
    sleep "$STREAMER_RAMP_DELAY"
done

# A one-shot start says so in the history: boot.log reads as the box's history,
# and this line is not a choice the listener made about the next boot.
one_shot=""
[ -n "$ad_hoc" ] && one_shot=" (this boot only)"
echo "playing $kind:$target at $now dB (target $level dB, floor $STREAMER_VOL_FLOOR dB)$one_shot"
log_boot "OK $kind $target at $now dB (target $level)$one_shot"
