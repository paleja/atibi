#!/usr/bin/env python3
"""streamer-play - this boot's playback: bring the source up, then ramp.

Started by streamer-play.service, and the only thing that starts audio, which
is what keeps the floor, the waits and the ramp unbypassable from the page,
from the command and from a reboot. Everything that decides what plays and
how loud it gets lives in streamer.boot; this file is the entry the unit
names, and its exit code, which systemd's Restart=on-failure reads.
"""

import sys

from streamer.app import Appliance
from streamer.boot import Boot
from streamer.conf import KnobError


def main():
    try:
        app = Appliance()
    except KnobError as exc:
        # No knobs means no idea what to play, and a silent speaker is the
        # alternative: say which knob, in the journal and in boot.log's wake.
        sys.stderr.write("%s\n" % exc)
        return 1
    return Boot(app).run()


if __name__ == "__main__":
    sys.exit(main())
