const FROM_URL=new URLSearchParams(location.search).get('token')||'';
let TOKEN='',playing=false,tick=0,pos=0,dur=0,timer=null;
let snap={},qrows=[],qplay;    // qplay: the list whose rows are on screen.
                               // Undefined means nothing has been fetched yet.
const $=id=>document.getElementById(id);
function setToken(t){
  // The token goes into localStorage only once the card has accepted it, so a typo kept
  // there cannot fail every later load. Empty deletes the stored one: a card re-flashed
  // with a new token must not leave the page locked out by its own memory of the old one.
  TOKEN=t||'';
  if(TOKEN)localStorage.setItem('atibi-token',TOKEN);
  else localStorage.removeItem('atibi-token');
}
async function tokenOk(t){
  // The cheapest question the card answers with the token: its own status.
  // Raw fetch, not api(), so a rejected token cannot recurse into itself.
  if(!t)return false;
  try{return(await fetch('/api/status',{headers:{'X-Token':t}})).status!==401;}
  catch(e){return false;}
}
async function api(path,body,retried){
  const opt=body?{method:'POST',headers:{'Content-Type':'application/json','X-Token':TOKEN},body:JSON.stringify(body)}
                 :{headers:{'X-Token':TOKEN}};
  const r=await fetch(path,opt);
  if(r.status===401&&!retried){
    // Whatever was being sent is refused, so ask for another token, check it, and replay
    // this one request: a card that changed its token means one dialog, not a reload
    // and a lost click.
    setToken('');
    const t=prompt('card token rejected, re-enter')||'';
    if(t&&await tokenOk(t)){setToken(t);return api(path,body,true);}
  }
  return r.json();
}
async function unlock(){
  // Three sources, in the order that makes each useful: a token in the URL (a bookmark,
  // or the redirect from /?token=...), one the browser remembers, then a typed one.
  // Whichever the card accepts is the one kept, so the secret is fetched over SSH once,
  // not at every desk.
  for(const cand of[FROM_URL,localStorage.getItem('atibi-token')])
    if(cand&&await tokenOk(cand)){setToken(cand);return true;}
  setToken('');
  for(let i=0;i<3;i++){
    const t=prompt('card token (from: sudo cat /data/atibi/http.token)');
    if(!t)return false;                      // cancelled, or typed nothing
    if(await tokenOk(t)){setToken(t);return true;}
  }
  return false;
}
function fail(m){$('err').className='err';$('err').textContent=m||'';if(m)setTimeout(()=>{if($('err').textContent==m)$('err').textContent=''},6000);}
function say(m){$('err').className='dim';$('err').textContent=m||'';if(m)setTimeout(()=>{if($('err').textContent==m)$('err').textContent=''},8000);}
function op(name){api('/api/op/'+name,{}).then(d=>{if(!d.ok)fail(d.error);poll();});}
function setVol(){api('/api/op/volume',{value:Number($('v').value)}).then(d=>{if(!d.ok)fail(d.error);poll();});}
function render(s){
  snap=s;
  const t=s.track||s.logical_track||{};
  // The list is named for its owner where the player knows a name for it (see list_name);
  // listkey() keeps using the raw label, because a name is not unique and an id is.
  const lname=s.playlist_name||s.playlist;
  $('t').textContent=t.title||'nothing playing';
  $('s').textContent=[t.artist,t.station&&('· '+t.station),lname&&('· '+lname)].filter(Boolean).join(' ');
  playing=s.state==='playing';$('pp').textContent=playing?'⏸':'▶';
  // The mode icons carry their own state in the page's one green. The player answers
  // shuffle as a flag and repeat as Off/all/one, which one button cycles, so any repeat
  // at all lights the icon and which of all or one it is stays on the player rather
  // than a word here. Both answers arrive on the next status poll.
  $('shuffle').classList.toggle('on',!!s.shuffle);
  $('repeat').classList.toggle('on',!!(s.repeat&&s.repeat!=='Off'));
  pos=s.position||0;dur=s.duration||0;
  // The level is the player's own (see live_volume), and it only moves the thumb when
  // nobody is holding it. Before the first answer the thumb sits at 0 - the value the
  // markup gives it, and the level cliamp starts a session at - rather than at the
  // middle of the range, where a browser puts a control nobody has set.
  $('vd').textContent=(s.volume===undefined?'':s.volume+' dB');
  if(document.activeElement!==$('v')&&s.volume!==undefined)$('v').value=Math.max(-50,Math.min(0,Math.round(s.volume)));
  const m=s.intent||{};$('mode').textContent=m.mode||'last';
  const lbl={provider:'playlist on ',album:'album on ',track:'track on ',playlist:'playlist: '};
  const svc=m.kind in lbl&&m.kind!=='playlist'?(m.provider||'?')+': ':'';
  // Name before id: the intent file can only hold the list id the provider gave it,
  // and /api/status sends back the name the owner gave it (see list_name). Without
  // that name the id is shown, never nothing.
  const shown=(m.kind==='track'&&(m.title||''))?m.title:(m.name||m.target||'(default)');
  $('intent').textContent=(lbl[m.kind]||'')+svc+shown+(m.volume?(' at '+m.volume+' dB to start with'):' (level not saved)');
  // Grey tab: the row playing has no provider the radio can follow. The page
  // itself goes away too, in case the provider changes while the tab is open.
  $('tab-radio').disabled=!s.radio;
  $('radio').classList.toggle('hidden',!s.radio||!$('tab-radio').classList.contains('on'));
  mark();
  // The rows are only honest if they are the list being played, so they are fetched
  // whenever that changes: another phone, the browse tab, a reboot, the first answer
  // after a refresh. A list from a streaming service has no name in the status at all,
  // so the number of rows rides along in the identity: same name, same count.
  if(!$('now').classList.contains('hidden')&&listkey(s)!==qplay)loadQueue();
}
function listkey(s){return (s.playlist||'')+'|'+(s.total===undefined?'':s.total);}
function paintBar(){if(dur>0)$('p').style.width=Math.min(100,100*tick/dur)+'%';}
async function poll(){
  if(document.hidden)return;
  const d=await api('/api/status');if(!d.ok&&d.error)fail(d.error);else{render(d);tick=d.position||0;}
}
setInterval(()=>{if(playing){tick+=0.5;paintBar();}},500);
function tab(name){
  for(const t of['browse','now','radio','boot']){$('tab-'+t).classList.toggle('on',t===name);$(t).classList.toggle('hidden',t!==name);}
  if(name==='browse')loadProviders();
  if(name==='now')loadQueue();
  // The tab is the question: opening it asks for the songs like this one.
  if(name==='radio')radioLoad();
  if(name==='boot')poll();   // this tab is all about the saved intent: show it now
}
async function loadProviders(){
  const d=await api('/api/providers');if(!d.ok){fail(d.error);return;}
  const sel=$('prov');const cur=sel.value;
  sel.innerHTML='';
  for(const p of d.providers){const o=document.createElement('option');o.value=p.key;o.textContent=p.name;sel.append(o);}
  if(cur)sel.value=cur;
  loadLists();
}
async function loadLists(){
  const d=await api('/api/playlists?provider='+encodeURIComponent($('prov').value));
  const ul=$('lists');ul.innerHTML='';
  if(!d.ok){fail(d.error);return}
  for(const p of d.playlists){
    const li=document.createElement('li');
    li.innerHTML=`<div class="what"><b></b><small></small></div>`;
    li.querySelector('b').textContent=p.name;
    li.querySelector('small').textContent=[p.section,p.track_count!==undefined?p.track_count+' tracks':''].filter(Boolean).join(' · ');
    const b=document.createElement('button');b.textContent='play';
    b.onclick=()=>api('/api/load/playlist',{provider:$('prov').value,id:p.id}).then(r=>{if(!r.ok)fail(r.error);tab('now');});
    li.append(b);ul.append(li);
  }
}
function provChanged(){loadLists();}
async function doSearch(){
  const q=$('q').value.trim();if(!q)return;
  const d=await api('/api/search?provider='+encodeURIComponent($('prov').value)+'&q='+encodeURIComponent(q));
  const ul=$('results');ul.innerHTML='';$('results-card').classList.remove('hidden');
  if(!d.ok){fail(d.error);return}
  for(const t of d.tracks){
    const li=document.createElement('li');
    li.innerHTML=`<div class="what"><b></b><small></small></div>`;
    li.querySelector('b').textContent=t.title;
    li.querySelector('small').textContent=[t.artist,t.album].filter(Boolean).join(' · ');
    const b=document.createElement('button');b.textContent='play';
    b.onclick=()=>api('/api/play',{track:t}).then(r=>{if(!r.ok)fail(r.error);tab('now');});
    li.append(b);ul.append(li);
  }
}
let radioList=[];
function radioButtons(){
  // There is nothing to queue or to save before the tab has an answer, and a greyed
  // button says that without a sentence under it.
  $('radio-queue').disabled=$('radio-save').disabled=!radioList.length;
}
async function radioLoad(){
  // Opening the tab asks the question and the card answers it: the page never sees
  // the account's access token, only the rows it shows and the two buttons on them.
  const d=await api('/api/radio');
  const ul=$('radio-list');ul.innerHTML='';
  radioList=d.ok?(d.tracks||[]):[];
  for(const t of radioList){
    const li=document.createElement('li');
    li.innerHTML=`<div class="what"><b></b><small></small></div>`;
    li.querySelector('b').textContent=t.title||'';
    li.querySelector('small').textContent=[t.artist,t.album].filter(Boolean).join(' · ');
    ul.append(li);
  }
  ul.classList.toggle('hidden',!radioList.length);
  radioButtons();
  if(!d.ok){fail(d.error);return;}
  if(!radioList.length)say('Tidal offered nothing similar to this track');
}
async function radioQueue(){
  if(!radioList.length)return;
  const d=await api('/api/radio/queue',{});
  if(!d.ok){fail(d.error);return;}
  say('now playing '+d.queued+' similar tracks, before the rest of the list');
  // The answer has been spent - those songs are in the player now, so both
  // buttons grey until the tab is opened again for a fresh one.
  radioList=[];radioButtons();
  loadQueue();
}
async function radioSave(){
  if(!radioList.length)return;
  const t=snap.track||snap.logical_track||{};
  const name=prompt('name the new playlist in the Tidal account',
                    (t.title||'radio')+' - radio');
  if(!name)return;
  const d=await api('/api/radio/save',{title:name});
  if(!d.ok){fail(d.error);return;}
  say('saved "'+d.title+'" with '+d.added+' tracks to the Tidal account');
  // The list on screen did not change, so its buttons stay as they are: the
  // songs can still be queued.
}
async function loadQueue(){
  // The list these rows are for is named before the wait, not after: if another list
  // loads while this one is being read, the next poll sees the mismatch and fetches
  // again. A failed read resets it, so the next poll retries instead of leaving an
  // empty list until something is clicked.
  qplay=listkey(snap);
  const d=await api('/api/queue');const ul=$('queue');ul.innerHTML='';qrows=[];
  if(!d.ok){qplay=undefined;fail(d.error);return;}
  // Every row, not a slice: a list cut short can hide the row being played. The
  // number shown is the row's own index - the figure /api/queue/play takes back -
  // and a row that answers without one sits at its own position, which is the order
  // queue.list returns.
  for(const[i,t]of(d.tracks||[]).entries()){
    const idx=Number.isInteger(t.index)?t.index:i;
    const li=document.createElement('li');
    li.className='tap';li.dataset.idx=idx;li.dataset.path=t.path||'';
    li.innerHTML=`<span class="num"></span><div class="what"><b></b><small></small></div>`;
    li.querySelector('.num').textContent=idx+1;
    li.querySelector('b').textContent=t.title||t.path||'';
    li.querySelector('small').textContent=[t.artist,t.album,t.station].filter(Boolean).join(' · ');
    li.onclick=()=>api('/api/queue/play',{index:idx}).then(r=>{if(!r.ok)fail(r.error);poll();});
    ul.append(li);qrows.push(li);
  }
  mark();
}
function mark(){
  // Which row to light up: the track the player says it is playing, and only if it
  // cannot name one, the index it reports. Verified on the card 2026-11-20 that they
  // need not agree - after a boot-time provider.load the index was 5 while the playing
  // track sat at row 0 - so the track decides first, and there is one green row.
  for(const r of qrows)r.classList.remove('cur');
  const t=snap.track||snap.logical_track||{};
  const path=String(t.path||'');
  let lit=false;
  if(path)for(const r of qrows)if(r.dataset.path===path){r.classList.add('cur');lit=true;}
  if(!lit&&Number.isInteger(snap.index))for(const r of qrows)
    if(Number(r.dataset.idx)===snap.index)r.classList.add('cur');
}
function useAtBoot(){
  // One question, the card answers it: what should the next boot load? Only the
  // player knows whether it sits on a playlist, an album, one track or a stream,
  // and the answer goes to `atibi remember` - the verb that writes the boot intent
  // without restarting what is already playing (see /api/boot/now).
  api('/api/boot/now',{}).then(d=>{if(!d.ok){fail(d.error);return;}poll();});
}
function intentMode(){
  api('/api/status').then(s=>{
    const m=(s.intent&&s.intent.mode)==='stop'?'last':'stop';
    api('/api/intent',{kind:'mode',target:m}).then(r=>{if(!r.ok)fail(r.error);poll();});
  });
}
async function start(){
  // Nothing is read before the token works out: every /api answer would come
  // back 401, and the page would say "nothing playing" about a card that is.
  if(!await unlock()){fail('no token this card accepts - reload the page to try again');return;}
  poll();timer=setInterval(poll,2000);
}
start();
</script></body></html>
"""


def main():
    global APP
    if pidfile := os.environ.get("ATIBI_HTTP_PIDFILE"):
        # setsid detaches this process, and only its pid can kill it then. The
        # test harness asks for one; systemd never sets this knob.
        with open(pidfile, "w", encoding="utf-8") as f:
            f.write(str(os.getpid()) + "\n")
    if os.environ.get("ATIBI_HTTP_TEST_NO_LISTEN"):
        print("port=%d token=%s socket=%s" %
              (CFG.port, CFG.token_path, CFG.socket_path))
        return 0
    APP = Appliance()
    CFG.token()   # makes the token on the first run, and says so in the journal
    server = http.server.ThreadingHTTPServer(("0.0.0.0", CFG.port), Handler)
    print("atibi-http: token-guarded, on :%d, player socket %s" %
          (CFG.port, CFG.socket_path), flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
