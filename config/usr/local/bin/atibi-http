#!/usr/bin/env python3
"""atibi-http - the appliance's LAN control server.

One small HTTP server on the card so a phone or any other computer can drive
the player without SSH, without a client binary, and without Omarchy: it
carries its own web page, so the browser is the whole client.

Design rules this file keeps to, and why:

- The server holds no state of its own: playback facts live in the cliamp
  daemon, read and written over its IPC socket; boot intent lives in the
  appliance state file and is written through the shared library's intent
  writers - the same two calls the command makes - never by the server touching
  the file. That keeps one writer for the record, keeps boot.log honest, and
  keeps the boot's floor and ramp unbypassable from a phone: nothing on the page
  can start audio, and nothing on the page can decide a level on its own.
- cliamp IPC version 2, newline-delimited JSON over the daemon's Unix socket:
  the same protocol `cliamp remote` uses. One connection per request under
  one lock keeps that traffic ordered with no reconnect logic, and requests
  are tiny, so churn costs nothing next to a TLS stream start.
- Everything under /api needs the token; the page itself is plain HTML.
  With a token in hand the root URL redirects to the app with it in the URL,
  because typing a 32-character secret on a phone is not a plan; from there
  the page keeps it in localStorage and sends it as an X-Token header, which
  a cross-site form cannot set - that is also the CSRF defence.
- Python 3 stdlib only: the card has python3 because RasPiOS Lite ships it,
  and nothing here may assume a package install on a read-only root.

Environment overrides (used by the test suite; systemd sets none):
  ATIBI_CONF       where the knobs live   (default /etc/atibi.conf)
  ATIBI_HTTP_PORT  TCP port               (default atibi.conf, then 8077)
  ATIBI_HTTP_TOKEN token file path        (default atibi.conf, then <data>/atibi/http.token)
  ATIBI_CLIAMP_SOCKET  the daemon socket  (default $HOME/.config/cliamp/cliamp.sock)
  ATIBI_HTTP_PIDFILE   write our pid here (test harness only; setsid detaches)
  ATIBI_SHARE_DIR    where the icons live (default /usr/local/share/atibi)
  ATIBI_HTTP_TEST_NO_LISTEN  print the config and exit 0 (packaging checks)
  ATIBI_RADIO_SIZE     how many similar songs the radio offers (atibi.conf, then 50)
  ATIBI_TIDAL_CRED     the Tidal login this server borrows (atibi.conf, then <data>/cliamp/tidal_credentials.json)
  ATIBI_PROVIDERS      the prefixes a target may carry (atibi.conf, then tidal qobuz spotify)
  ATIBI_RADIO_PROVIDERS  providers whose rows the radio can follow (atibi.conf, then tidal)
"""

import errno
import hmac
import http.server
import json
import os
import re
import secrets
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

from atibi.app import Appliance
from atibi.intent import (NoTarget, parse_target, record_level, record_mode,
                             record_now, record_target)

CONF_PATH_DEFAULT = "/etc/atibi.conf"
SHARE_DEFAULT = "/usr/local/share/atibi"
# The mark this page wears, read from the payload at start and served like the
# page itself - unauthenticated, because an icon carries nothing. A missing
# asset is a 404 and nothing else changes: the page works without its icon.
SHARE_DIR = os.environ.get("ATIBI_SHARE_DIR", SHARE_DEFAULT)
ICON_MIME = {"favicon.ico": "image/x-icon", "favicon.svg": "image/svg+xml"}
IPC_LOCK = threading.Lock()
PROVIDERS_CACHE = {"at": 0.0, "data": []}
# The appliance this server writes through: knobs, record, log and player from
# the library, built once at start. The three routes that decide anything reach
# for this and nothing else: the record has one writer, and the page reaches it
# the same way the command does, so neither can grow its own idea of the format.
APP = None


def read_conf(path):
    """The few key=value lines this server needs. Same file every atibi-*
    script sources, so the knob set (port, token path) lives in one place. A
    double-quoted value may hold spaces, which is how the shell sources it too:
    ATIBI_PROVIDERS is a list of names, and reading it unquoted would hand
    this server a first word and a stray quote."""
    conf = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                m = re.match(r'^([A-Z_][A-Z0-9_]*)=("[^"]*"|\S+)', line)
                if m:
                    conf[m.group(1)] = m.group(2).strip('"')
    except FileNotFoundError:
        pass
    return conf


def expand(value, conf):
    """atibi.conf uses $ATIBI_DATA inside later values; the shell would
    expand that when sourcing, here we resolve just that one variable."""
    return value.replace("$ATIBI_DATA", conf.get("ATIBI_DATA", "/data"))


class Config:
    def __init__(self):
        conf = read_conf(os.environ.get("ATIBI_CONF", CONF_PATH_DEFAULT))
        self.port = int(os.environ.get(
            "ATIBI_HTTP_PORT", conf.get("ATIBI_HTTP_PORT", "8077")))
        token = os.environ.get("ATIBI_HTTP_TOKEN") or expand(
            conf.get("ATIBI_HTTP_TOKEN",
                     "$ATIBI_DATA/atibi/http.token"), conf)
        self.token_path = token
        home = os.environ.get("HOME", "")
        self.socket_path = os.environ.get(
            "ATIBI_CLIAMP_SOCKET",
            os.path.join(home, ".config", "cliamp", "cliamp.sock"))
        # The player's own command, for the one thing the IPC snapshot cannot answer
        # (see live_volume). Absolute rather than looked up: this server should not
        # find a different cliamp than the daemon it is controlling.
        self.cliamp = os.environ.get("ATIBI_CLIAMP_EXECUTABLE",
                                     "/usr/local/bin/cliamp")
        self.radio_size = int(os.environ.get(
            "ATIBI_RADIO_SIZE", conf.get("ATIBI_RADIO_SIZE", "50")))
        self.tidal_cred = os.environ.get("ATIBI_TIDAL_CRED") or expand(
            conf.get("ATIBI_TIDAL_CRED",
                     "$ATIBI_DATA/cliamp/tidal_credentials.json"), conf)
        # The list the atibi command reads, read here as well so a target this
        # server writes is one that command spells the same way: this is what tells
        # both where a provider name ends and a bare id begins.
        self.providers = (os.environ.get("ATIBI_PROVIDERS")
                          or conf.get("ATIBI_PROVIDERS",
                                      "tidal qobuz spotify")).split()
        # Which providers the radio can follow. Tidal is the only one whose API answers
        # a track radio at all (see the note in the Tidal section), so this is the one
        # honest place where that is written down; the page asks the card instead of
        # naming a provider itself.
        self.radio_providers = (os.environ.get("ATIBI_RADIO_PROVIDERS")
                                or conf.get("ATIBI_RADIO_PROVIDERS",
                                            "tidal")).split()

    def token(self):
        """The LAN secret, made once and kept on /data. Printed to the journal
        the time it is created so the owner can read it off `atibi log`
        without any client configured yet."""
        try:
            with open(self.token_path, encoding="utf-8") as f:
                return f.read().strip()
        except FileNotFoundError:
            pass
        token = secrets.token_hex(16)
        os.makedirs(os.path.dirname(self.token_path), exist_ok=True)
        tmp = self.token_path + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(token + "\n")
        os.replace(tmp, self.token_path)
        print("http.token created; the control URL is "
              "http://<this card>:%d/?token=%s" % (self.port, token),
              flush=True)
        return token

    def check_token(self, candidate):
        return bool(candidate) and hmac.compare_digest(
            candidate, self.token())


CFG = Config()


# --- cliamp IPC v2 ------------------------------------------------------------

class IpcError(Exception):
    pass


def _recv_line(sock_file):
    line = sock_file.readline()
    if not line:
        raise IpcError("the player closed the connection")
    return line


def ipc(method, params=None, id_hint="h", envelope=None):
    """One V2 request/reply. Envelope fields are not a style choice: the real
    daemon answers invalid_request unless operation.submit carries its
    operation name on the envelope, beside method rather than inside params,
    and invalid_params unless job.get carries job_id the same way. Only
    operation.submit has a params object at all. Verified against cliamp
    2.4.1 on the card."""
    req = {"version": 2, "id": id_hint, "method": method}
    if envelope:
        req.update(envelope)
    if params is not None:
        req["params"] = params
    with IPC_LOCK:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(5.0)
            s.connect(CFG.socket_path)
            f = s.makefile("rwb")
            f.write((json.dumps(req) + "\n").encode())
            f.flush()
            while True:
                reply = json.loads(_recv_line(f))
                # Only a subscribe pushes unsolicited events, and this server never
                # subscribes; matching the id anyway keeps a stray frame from being
                # read as an answer.
                if reply.get("id") == id_hint:
                    return reply
        except (OSError, ValueError) as exc:
            raise IpcError(str(exc)) from exc
        finally:
            try:
                s.close()
            except Exception:
                pass


def _job_wait(job, hint_base):
    """operation.submit answers with a job that may still be running. Poll it
    the way `cliamp remote call --wait` does: slow is fine (a Tidal playlist
    load is exactly the case), silent failure is not."""
    final = {"succeeded", "failed", "canceled"}
    tries = 0
    while job.get("state") not in final:
        tries += 1
        if tries > 240:  # 240 * 0.5 s = 120 s. A 50-track Tidal playlist load
                         # the docs say slow work stays async, and a load that
                         # gave up early would stop being waitable at all.
            raise IpcError("job %s did not finish in time" % job.get("id"))
        if not job.get("id"):
            raise IpcError("the player submitted no job")
        reply = ipc("job.get", id_hint=hint_base + ".j%d" % tries,
                    envelope={"job_id": job["id"]})
        if not reply.get("ok"):
            raise IpcError(reply.get("error", "job vanished"))
        job = reply.get("job", job)
        if job.get("state") not in final:
            time.sleep(0.5)  # the comment about 0.5 s per try only means
                             # something if the loop actually waits
    return job


def ipc_op(operation, params=None):
    """One V2 operation, waited. Returns the job's result, or raises."""
    reply = ipc("operation.submit", params, id_hint="h",
                envelope={"operation": operation})
    if not reply.get("ok"):
        raise IpcError(reply.get("error", "operation refused"))
    job = _job_wait(reply.get("job", {}), "h")
    if job.get("state") != "succeeded":
        detail = job.get("result", {}).get("detail") or job["state"]
        raise IpcError("%s: %s" % (operation, detail))
    return job.get("result", {})


# --- the appliance side: the record and the level, through the library -------


def live_volume():
    """The level the player is at, which the IPC snapshot cannot answer.

    The library's reader: one json.loads on `cliamp status --json`, which
    pretty-prints and repeats some keys - a line-based extractor that assumed
    compact JSON was a known failure mode here, and it is gone.
    """
    return APP.player.level()


def read_intent():
    """The record, with the shipped defaults filled in: what a reboot loads."""
    return APP.read_record()


# --- Tidal radio ---------------------------------------------------------------
#
# "Similar songs" for what is playing is not something cliamp 2.4.1 can do,so this
# server borrows Tidal's login rather than having an account of its own. Verified:

#   GET /v1/tracks/<id>/radio?countryCode=.. answers real track rows; the siblings
#   /tracks/<id>/similar, /trackradio/<id> and /mixes do not exist.
#   POST /v2/my-collection/playlists/folders/create-playlist, then the ETag'd POST
#   to /v1/playlists/<uuid>/items, create and fill a real playlist in the account;
#   DELETE removes it.

# Rules this borrowing keeps to:
# - The session file is read fresh on every call and never refreshed here. cliamp owns
#   that login, and two programs refreshing one OAuth session is how logins get killed;
#   a token that turns out stale is reported, not chased.
# - The /v1 (or /v2) segment and countryCode are not decoration: without the segment
#   the CDN answers a plain 404 page, and the playlist calls 400 without the country.
# - Saving writes into the owner's Tidal account, so only the sequence verified above is
#   used, and a playlist left empty by a failed fill is deleted again.

TIDAL_API = "https://api.tidal.com"


class TidalError(Exception):
    pass


def tidal_login():
    """(access token, country code) from cliamp's session file, read fresh."""
    try:
        with open(CFG.tidal_cred, encoding="utf-8") as f:
            cred = json.load(f)
    except (OSError, ValueError) as exc:
        raise TidalError("no Tidal login on this card to borrow (%s)" % exc) from exc
    token = str(cred.get("access_token") or "")
    if not token:
        raise TidalError("the stored Tidal login has no access token")
    return token, str(cred.get("country_code") or "US")


def tidal_call(method, path, params=None, form=None, headers=None):
    """One Tidal API call. Returns (status, json-or-text, response headers);
    raises TidalError for transport failures and for the one status code with
    a known meaning here: 401, the saved login having gone stale."""
    token, country = tidal_login()
    query = {"countryCode": country}
    query.update(params or {})
    url = TIDAL_API + path + "?" + urllib.parse.urlencode(query)
    data = urllib.parse.urlencode(form).encode() if form is not None else None
    hd = {"Authorization": "Bearer " + token, "Accept": "application/json"}
    hd.update(headers or {})
    if data is not None:
        hd["Content-Type"] = "application/x-www-form-urlencoded"
    req = urllib.request.Request(url, data=data, method=method, headers=hd)
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            raw, status, hdrs = resp.read().decode(), resp.status, resp.headers
    except urllib.error.HTTPError as exc:
        if exc.code == 401:
            raise TidalError("Tidal refused the login saved on this card - "
                             "play something from Tidal once to sign it in "
                             "again") from exc
        raise TidalError("Tidal said %s to %s %s" % (exc.code, method, path)) from exc
    except OSError as exc:
        raise TidalError("cannot reach Tidal: %s" % exc) from exc
    try:
        return status, json.loads(raw), hdrs
    except ValueError:
        return status, raw, hdrs


def tidal_seed():
    """(tidal track id, playing row) for whatever the player is on, or
    (None, None) when it is not on a Tidal track. The id prefers the row's own
    provider_meta, with the path's tail as the fallback the /api/play route
    already trusts."""
    snap = ipc("state.get").get("snapshot", {})
    for key in ("track", "logical_track"):
        row = snap.get(key) or {}
        hit = TRACK_ROW.match(str(row.get("path", "")))
        if hit and hit.group(1) == "tidal":
            meta = row.get("provider_meta") or {}
            return str(meta.get("tidal.id") or hit.group(2)), row
    return None, None


def radio_tracks(seed):
    """Tidal's similar songs for one track, in Tidal's own order: the seed
    itself dropped (the first row of the answer is usually it), unstreamable
    rows dropped, cut at ATIBI_RADIO_SIZE. The rows carry everything the
    player needs to queue them without resolving them again - track.queue
    asked for a bare path leaves an unresolved stub row, verified on the card
    - and no year key at all rather than an empty one, which the player
    refuses."""
    _, body, _ = tidal_call("GET", "/v1/tracks/%s/radio" % seed,
                            {"limit": str(CFG.radio_size + 1)})
    items = body.get("items") if isinstance(body, dict) else None
    out = []
    for t in items or []:
        tid = str(t.get("id", ""))
        if not tid or tid == seed or not t.get("allowStreaming", True):
            continue
        row = {"path": "tidal://track/%s" % tid,
               "title": str(t.get("title", "")),
               "artist": str((t.get("artist") or {}).get("name", "")),
               "album": str((t.get("album") or {}).get("title", "")),
               "duration_secs": t.get("duration"),
               "track_number": t.get("trackNumber"),
               "stream": True,
               "provider_meta": {"tidal.id": tid}}
        out.append({k: v for k, v in row.items() if v is not None})
        if len(out) >= CFG.radio_size:
            break
    return out


# --- HTTP ---------------------------------------------------------------------

TRANSPORT_OPS = {"play", "pause", "toggle", "next", "prev", "stop"}
MODE_OPS = {"shuffle", "repeat"}

# A provider search row whose path is provider://album/<id> stands for a whole album,
# not one streamable track. Verified on the card against cliamp 2.4.1: Tidal search
# answers rows like that (provider_meta.kind says "album", no stream flag), and the
# player can only open real track rows: hand one of these to track.play and the job
# says succeeded while the play pipeline answers a plain filesystem error. See /api/play.
ALBUM_ROW = re.compile(r"\A([a-z][a-z0-9-]*)://album/(\S+)\Z")

# The matching shape for a single track row: the scheme names the provider and the tail
# is the provider's own track id, which is exactly what the boot needs to rebuild the
# row (see the album|track branch of atibi-play, and why the display strings are
# saved with it). A row whose path is not this shape - a file on the card, say - plays
# but is not remembered: the boot cannot reach anything by that id anyway.
TRACK_ROW = re.compile(r"\A([a-z][a-z0-9-]*)://track/(\S+)\Z")

# What cliamp puts in the snapshot's "playlist" key. Verified on the card 2026-11-21,
# four shapes, and only these four: a Tidal playlist is "tidal:<list id>", a Tidal
# album is "tidal:album:<album id>" - a spelling its own provider.load refuses, so the
# word "album" is taken back out before the boot is told what to load - a playlist
# saved on the card is its bare name, and the built-in cliamp radio channel is
# "radio:l:0", which only provider.load can open. A track played with track.play comes
# back with no "playlist" key at all. That grammar is why the boot intent cannot be
# worked out in the page: it is a fact about the player, and a wrong guess writes an
# intent that boots to silence.
LIST_ALBUM = re.compile(r"\A([a-z][a-z0-9-]*):album:(\S+)\Z")
LIST_PROVIDER = re.compile(r"\A([a-z][a-z0-9-]*):(\S+)\Z")

# Provider -> (when it was read, {list id: name}). The listing is the only place a
# list's own name comes from, and `provider.playlists` is a call to the service while
# the page polls /api/status every two seconds, so this is one read per provider every
# LIST_NAMES_TTL seconds, whatever else the poll does. A provider that answers nothing
# is cached as an empty listing too; a list renamed in the account appears under its
# new name at the next read.
LISTS_CACHE = {}
LIST_NAMES_TTL = 15


def list_names(provider):
    got = LISTS_CACHE.get(provider)
    if got and time.time() - got[0] < LIST_NAMES_TTL:
        return got[1]
    names = {}
    try:
        res = ipc_op("provider.playlists", {"provider": provider, "limit": 100})
        for row in res.get("playlists", []):
            if isinstance(row, dict) and row.get("id") is not None:
                names[str(row["id"])] = str(row.get("name") or "")
    except Exception:
        pass                         # see LISTS_CACHE: the caller falls back
    LISTS_CACHE[provider] = (time.time(), names)
    return names


def list_name(label):
    """The player's label for a loaded list, said the way its owner would.

    The snapshot spells a Tidal list by its id (`tidal:b9823cb3-f037-42dd-…`),
    which is what the page has been showing; the person looking at it knows
    that list as `tidal:Lana`. A bare label (a playlist saved on the card is
    its own name) and an id that is not in the provider's listing are returned
    unchanged: showing an id is worse than a name, but it is still the truth,
    and guessing is not on offer."""
    label = str(label or "")
    hit = LIST_PROVIDER.match(label)
    if not hit or hit.group(1) not in CFG.providers:
        return label
    name = list_names(hit.group(1)).get(hit.group(2), "")
    return "%s:%s" % (hit.group(1), name) if name else label


def snap_row(snap, key):
    """The row under `key`, or nothing usable. A snapshot that answers a row
    as a bare string (the harness does, for the built-in radio rows) must not
    take /api/status down: the page polls that route every two seconds, so an
    unparseable row is worth treating as "no row" rather than as an error."""
    row = snap.get(key)
    return row if isinstance(row, dict) else {}


def radio_of(snap):
    """The provider whose rows the radio can follow, for the row playing now
    ('' when it is none of them: the built-in radio channel, a file on the
    card). The page hides its radio section on this answer rather than testing
    a path scheme in JavaScript, so a second supported service needs a knob
    edit here and no change to the page at all."""
    for key in ("track", "logical_track"):
        row = snap_row(snap, key)
        hit = TRACK_ROW.match(str(row.get("path", "")))
        if hit and hit.group(1) in CFG.radio_providers:
            return hit.group(1)
    return ""


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "atibi-http/1"

    def log_message(self, fmt, *args):
        print("%s %s" % (self.address_string(), fmt % args), flush=True)

    # -- helpers --

    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json_out(self, obj, code=200):
        self._send(code, json.dumps(obj, separators=(",", ":")))

    def _asset(self, path):
        """One icon file, straight off the payload's share directory."""
        name = path.lstrip("/")
        try:
            with open(os.path.join(SHARE_DIR, name), "rb") as handle:
                body = handle.read()
        except OSError:
            self._send(404, b"")
            return
        self._send(200, body, ICON_MIME[name])

    def _authorized(self):
        given = self.headers.get("X-Token", "")
        if not given:
            given = urllib.parse.urlparse(self.path).query
            given = urllib.parse.parse_qs(given).get("token", [""])[0]
        return CFG.check_token(given)

    def _body(self):
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        raw = self.rfile.read(length) if length else b""
        try:
            return json.loads(raw or b"{}")
        except ValueError:
            return {}

    # -- routes --

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path, query = parsed.path, urllib.parse.parse_qs(parsed.query)
        if path == "/":
            token = query.get("token", [""])[0]
            if token and CFG.check_token(token):
                # A 302 with no body: Location goes out before _send ends the
                # headers, because end_headers must run exactly once.
                self.send_response(302)
                self.send_header("Location", "/app?token=" + token)
                self.send_header("Content-Length", "0")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                return
            self._send(200, PAGE, "text/html; charset=utf-8")
            return
        if path[1:] in ICON_MIME:
            self._asset(path)
            return
        if not self._authorized():
            self._json_out({"ok": False, "error": "unauthorized"}, 401)
            return
        try:
            self._route_get(path, query)
        except IpcError as exc:
            self._json_out({"ok": False, "error": str(exc)}, 502)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path, query = parsed.path, urllib.parse.parse_qs(parsed.query)
        if not self._authorized():
            self._json_out({"ok": False, "error": "unauthorized"}, 401)
            return
        body = self._body()
        try:
            self._route_post(path, body)
        except IpcError as exc:
            self._json_out({"ok": False, "error": str(exc)}, 502)

    def _route_get(self, path, query):
        if path in ("/app", "/app/"):
            self._send(200, PAGE, "text/html; charset=utf-8")
            return
        if path == "/api/status":
            snap = ipc("state.get").get("snapshot", {})
            keep = ("state", "track", "logical_track", "position", "duration",
                    "seekable", "volume", "playlist", "index", "total",
                    "shuffle", "repeat", "stream_error")
            out = {k: snap[k] for k in keep if k in snap}
            # The level, from the player itself: the snapshot has no such key (see
            # live_volume). The snapshot's value is left in place when the player cannot
            # be asked, so the page still shows a level rather than nothing.
            vol = live_volume()
            if vol is not None:
                out["volume"] = vol
            # Which provider the radio can follow, for the row playing now: the page
            # greys its radio tab when this names none, so it cannot offer to queue
            # songs for a file on the card or for the built-in radio channel.
            out["radio"] = radio_of(snap)
            # The same list the player names by its id, said the way its owner would
            # (see list_name). The raw label rides along too: listkey() identifies the
            # list whose rows are on screen by that label, because names are not unique.
            out["playlist_name"] = list_name(snap.get("playlist", ""))
            intent = read_intent()
            if intent["kind"] == "provider" and intent["provider"]:
                # The boot card's line gets the same courtesy: the intent file holds the
                # list id, and a person choosing what boots wants the name they gave it.
                # Bare, without the provider in front - that line already spells the
                # provider itself. Unset when the list is not in the provider's listing,
                # so the card falls back to the id rather than to nothing.
                name = list_names(intent["provider"]).get(intent["target"], "")
                if name:
                    intent["name"] = name
            out["intent"] = intent
            self._json_out({"ok": True, **out})
            return
        if path == "/api/providers":
            self._json_out({"ok": True,
                            "providers": self._providers(),
                            "intent": read_intent()})
            return
        if path == "/api/playlists":
            provider = query.get("provider", [""])[0]
            if not provider:
                self._json_out({"ok": False, "error": "provider= required"}, 400)
                return
            res = ipc_op("provider.playlists",
                         {"provider": provider, "limit": 100})
            self._json_out({"ok": True, "playlists": res.get("playlists", [])})
            return
        if path == "/api/search":
            provider = query.get("provider", [""])[0]
            q = query.get("q", [""])[0]
            if not provider or not q:
                self._json_out({"ok": False, "error": "provider= and q= required"}, 400)
                return
            res = ipc_op("provider.search",
                         {"provider": provider, "query": q, "limit": 30})
            self._json_out({"ok": True, "tracks": res.get("tracks", [])})
            return
        if path == "/api/queue":
            res = ipc_op("queue.list", {"limit": 200})
            # The row index the player says it is on comes back too: that is
            # what numbers the list and what marks the row it is playing now.
            self._json_out({"ok": True, "tracks": res.get("tracks", []),
                            "index": res.get("index"), "total": res.get("total")})
            return
        if path == "/api/radio":
            # The preview: what Tidal says is similar to the track playing now.
            # Nothing changes; the two POST routes below act on these rows.
            seed, _playing = tidal_seed()
            if not seed:
                self._json_out({"ok": False,
                                "error": "radio follows the Tidal track that "
                                         "is playing, and nothing Tidal is"}, 409)
                return
            try:
                tracks = radio_tracks(seed)
            except TidalError as exc:
                self._json_out({"ok": False, "error": str(exc)}, 502)
                return
            self._json_out({"ok": True, "seed": seed, "tracks": tracks})
            return
        self._json_out({"ok": False, "error": "not found"}, 404)

    def _route_post(self, path, body):
        if path == "/api/op/shuffle":
            self._json_out(self._op("shuffle", {"name": body.get("name", "toggle")}))
            return
        if path == "/api/op/repeat":
            self._json_out(self._op("repeat", {"name": body.get("name", "cycle")}))
            return
        if path in {"/api/op/" + op for op in TRANSPORT_OPS}:
            self._json_out(self._op(path.rsplit("/", 1)[1], {}))
            return
        if path == "/api/op/volume":
            try:
                db = float(body.get("value"))
            except (TypeError, ValueError):
                self._json_out({"ok": False, "error": "value must be a dB number"}, 400)
                return
            # Set through the socket, remembered through the appliance, and read
            # back rather than trusted: cliamp clamps to the volume_min in
            # /data/cliamp/config.toml and to +6, and what it settled at is what
            # the next boot aims at. A level at or below the boot floor is a
            # parked control, so the saved level carries on instead.
            ipc_op("volume", {"value": db})
            record_level(APP)
            self._json_out({"ok": True, "level": APP.player.level()})
            return
        if path == "/api/op/seek":
            try:
                where = float(body.get("value"))
            except (TypeError, ValueError):
                self._json_out({"ok": False, "error": "value must be seconds"}, 400)
                return
            self._json_out(self._op("seek.absolute", {"value": where}))
            return
        if path == "/api/load/playlist":
            provider = str(body.get("provider", ""))
            pid = str(body.get("id", ""))
            if not provider or not pid:
                self._json_out({"ok": False, "error": "provider and id required"}, 400)
                return
            ipc_op("provider.load", {"provider": provider, "playlist": pid})
            # Nothing is remembered here. What plays next boot is set only by the
            # `atibi` command and the page's "use the now playing" button; a tap
            # in the browse tab plays, and that is all it claims to do - the boot target
            # is a separate decision, taken in the boot tab.
            self._json_out({"ok": True})
            return
        if path == "/api/load/url":
            url = str(body.get("url", ""))
            if not url.startswith(("http://", "https://")):
                self._json_out({"ok": False,
                                "error": "url must be http(s)"}, 400)
                return
            ipc_op("url.load", {"path": url, "play": True})
            self._json_out({"ok": True})
            return
        if path == "/api/queue/play":
            # Tapping a row of the live list: queue.play takes the row's index, and
            # the player jumps to it. Verified on the card against 2.4.1: the job
            # succeeds and the snapshot's index and track follow the row asked for, so
            # the page's number and the player's agree.
            try:
                row = int(body.get("index"))
            except (TypeError, ValueError):
                self._json_out({"ok": False, "error": "index must be a row number"}, 400)
                return
            if row < 0:
                self._json_out({"ok": False, "error": "index must be a row number"}, 400)
                return
            # No intent written here, on purpose: this row belongs to a list that is
            # already the boot intent, and a position within it is not something the
            # appliance records.
            ipc_op("queue.play", {"index": row})
            self._json_out({"ok": True})
            return
        if path == "/api/play":
            track = body.get("track")
            if not isinstance(track, dict):
                self._json_out({"ok": False, "error": "track object required"}, 400)
                return
            hit = ALBUM_ROW.match(str(track.get("path", "")))
            if hit:
                # An album search hit is a placeholder row standing for a whole album,
                # so the operation asked for is the one the TUI runs when Enter lands on
                # it: expand it into its real track rows and start playing. The scheme
                # names the provider, so this holds for any provider that spells its
                # rows this way, not only Tidal.
                meta = track.get("provider_meta") or {}
                album = str(meta.get("albumID") or hit.group(2))
                ipc_op("provider.load_album",
                       {"provider": hit.group(1), "album": album})
                self._json_out({"ok": True})
                return
            ipc_op("track.play", {"track": track})
            # Playing a row from the phone is not a boot decision either (see
            # /api/load/playlist): what the next reboot loads stays what the boot tab
            # says it is.
            self._json_out({"ok": True})
            return
        if path == "/api/intent":
            # The boot tab's decision: what plays next boot, and nothing about
            # what is playing now. Written through the appliance, the same writer
            # the command uses, which is also the only writer of boot.log: the
            # page cannot grow its own idea of the record's shape, and a tapped
            # row that already started its music is never restarted from here.
            kind = body.get("kind")
            target = str(body.get("target", ""))
            try:
                if kind == "mode":
                    if target not in ("last", "stop"):
                        raise ValueError("mode last|stop")
                    saved = record_mode(APP, target == "last")
                else:
                    fields = parse_target(kind, target, APP.conf.providers)
                    saved = record_target(APP, fields)
            except (ValueError, NoTarget) as exc:
                self._json_out({"ok": False, "error": str(exc)}, 400)
                return
            self._json_out({"ok": True, "intent": saved})
            return
        if path == "/api/boot/now":
            # The page's "use the now playing" button: next boot = what is playing
            # now. The card works out the shape - the snapshot's playlist label
            # decides whether that is a service list, an album, a list saved on
            # the card or a single row - so the page asks one dumb question
            # instead of guessing, and the level is captured in the same breath.
            try:
                saved = record_now(APP)
            except NoTarget as exc:
                self._json_out({"ok": False, "error": str(exc)}, 409)
                return
            self._json_out({"ok": True, "intent": saved})
            return
        if path == "/api/radio/queue":
            # Extend the live queue with the similar songs. Read from Tidal again
            # here rather than taken from the page's preview: the preview is a look,
            # the action is whatever Tidal calls similar now, and a body of hand-written
            # ids would let a page push arbitrary rows into the player - the same reason
            # the boot intent is only ever written by the atibi command.
            seed, _playing = tidal_seed()
            if not seed:
                self._json_out({"ok": False,
                                "error": "radio follows the Tidal track that "
                                         "is playing, and nothing Tidal is"}, 409)
                return
            try:
                tracks = radio_tracks(seed)
            except TidalError as exc:
                self._json_out({"ok": False, "error": str(exc)}, 502)
                return
            # track.queue, not queue: verified on the card 2026-11-20 that repeated
            # calls land in the player's play-next area, keep the order asked for, and
            # play before the rest of the loaded list - and that every row must carry
            # its fetched metadata, a bare path makes an unresolved stub. No boot intent
            # touched: the saved list stays exactly as it was.
            for row in tracks:
                ipc_op("track.queue", {"track": row})
            self._json_out({"ok": True, "queued": len(tracks)})
            return
        if path == "/api/radio/save":
            # The other half: keep the same songs as a real playlist in the owner's
            # Tidal account, under a title they typed. The only place in this server
            # that writes to a provider account, with the create/fill sequence verified
            # end to end on the card 2026-11-20; a playlist left empty by a failed fill
            # is deleted again rather than left behind.
            title = str(body.get("title", "")).strip()[:120]
            if not title:
                self._json_out({"ok": False,
                                "error": "playlist title required"}, 400)
                return
            seed, playing = tidal_seed()
            if not seed:
                self._json_out({"ok": False,
                                "error": "radio follows the Tidal track that "
                                         "is playing, and nothing Tidal is"}, 409)
                return
            from_line = " - ".join(
                x for x in (str((playing or {}).get("artist", "")),
                            str((playing or {}).get("title", ""))) if x)
            try:
                tracks = radio_tracks(seed)
                if not tracks:
                    raise TidalError("Tidal offered nothing similar to save")
                st, created, _ = tidal_call(
                    "PUT",
                    "/v2/my-collection/playlists/folders/create-playlist",
                    {"name": title,
                     "description": ("atibi radio, from " + from_line)
                                     if from_line else "",
                     "folderId": "root"})
                uuid = ""
                if isinstance(created, dict):
                    uuid = str((created.get("data") or {}).get("uuid")
                               or created.get("uuid") or "")
                if st != 200 or not uuid:
                    raise TidalError("Tidal refused to create the playlist "
                                     "(%s)" % st)
                # Filling a playlist is conditional on its ETag, verified the same
                # day: the POST to /items answers 412, or adds nothing, unless it
                # carries If-None-Match from a fresh GET.
                _, _, hdrs = tidal_call("GET", "/v1/playlists/%s" % uuid)
                etag = hdrs.get("ETag") or "*"
                st, added, _ = tidal_call(
                    "POST", "/v1/playlists/%s/items" % uuid,
                    form={"trackIds": ",".join(
                             str(r["path"]).rsplit("/", 1)[-1] for r in tracks),
                          "toIndex": 0, "onArtifactNotFound": "SKIP",
                          "onDupes": "SKIP"},
                    headers={"If-None-Match": etag})
                n = (len(added.get("addedItemIds") or [])
                     if isinstance(added, dict) else 0)
                if st != 200 or not n:
                    # Nothing got in: take the empty shell back out of the account,
                    # refused or an accept-everything response that added no ids.
                    tidal_call("DELETE", "/v1/playlists/%s" % uuid)
                    raise TidalError("Tidal added nothing to the new playlist")
            except TidalError as exc:
                self._json_out({"ok": False, "error": str(exc)}, 502)
                return
            self._json_out({"ok": True, "uuid": uuid, "added": n,
                            "title": title})
            return
        self._json_out({"ok": False, "error": "not found"}, 404)

    @staticmethod
    def _op(operation, params):
        ipc_op(operation, params)
        return {"ok": True}

    @staticmethod
    def _providers():
        import time
        now = time.monotonic()
        if now - PROVIDERS_CACHE["at"] < 15 or not PROVIDERS_CACHE["data"]:
            res = ipc_op("provider.list", {})
            PROVIDERS_CACHE["at"] = now
            PROVIDERS_CACHE["data"] = res.get("providers", [])
        return PROVIDERS_CACHE["data"]


