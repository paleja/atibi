#!/bin/sh
# streamer [command] - the control for the appliance, meant to be used over SSH.
# The command list below is what `streamer nonsense` prints, so keep it current.
#
#   streamer                    same as: streamer status
#   streamer status             what is playing now, and what plays next boot
#   streamer play               play the saved target again, with the ramp
#   streamer pause | toggle     transport
#   streamer stop               stop now, and stay quiet after the next boot
#   streamer next | prev        skip
#   streamer vol -12            set the level to -12 dB, next boot too
#   streamer up 3 | down 3      move the level by N dB, next boot too
#   streamer station <url>      play this stream now
#   streamer playlist <name>    play a saved cliamp playlist now
#   streamer playlist tidal:ID  play a streaming service playlist now
#   streamer album tidal:ID     play an album from a streaming service
#   streamer track tidal:ID     play one track from a streaming service
#                               --save on those four: this one plays next boot too
#   streamer remember <what> <target>
#                               next boot only, without touching what plays now
#   streamer stations           list the built-in radio endpoints
#   streamer last               what the appliance will play on next boot
#   streamer mode [last|stop]   resume-on-boot behaviour
#   streamer log                this boot's player log
#   streamer boots              the durable boot log, the one that survives a cut
#   streamer reload             restart daemon and playback
#   streamer audio [jack|dac]   show or switch the audio output
#   streamer rw | ro            make / writable, then read-only again
#   streamer reset --yes        wipe /data and put back what the card shipped with
set -eu

. /etc/streamer.conf
# A card flashed before this knob existed keeps the same default path.
STREAMER_PLAY_NOW=${STREAMER_PLAY_NOW:-/run/streamer/play-now}

usage() { # the command list at the top of this file, which is its own help text
    awk 'NR == 1 { next } /^set -eu/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

# Some commands need root: system units, the read-only root, /data. The
# image ships a sudoers drop-in for exactly this, so they re-run under sudo
# once (STREAMER_SUDO marks the second pass).
needs_root() { # needs_root <command> [argument]
    case "$1" in
        play|station|playlist|album|track|reload|reset|rw|ro) return 0 ;;
        audio) [ -n "${2:-}" ] && return 0 ; return 1 ;;
        *) return 1 ;;
    esac
}

# Atomically replaces the record of what plays next boot and how loud. Omitted
# arguments carry on what the file already holds, so changing the level cannot
# forget the target. Nothing else writes this file.
#
# title/artist/album belong to a kind=track target: cliamp 2.4.1 cannot fetch
# a track by id, so streamer-play rebuilds the row from these strings. An
# omitted triple carries on what the file holds; any other kind drops it.
save_state() { # save_state <mode> <kind> <target> [provider] [volume] [title] [artist] [album]
    mode=$1 kind=$2 cur=$3
    [ "$#" -ge 4 ] && provider=$4
    [ "$#" -ge 5 ] && cur_vol=$5
    [ "$#" -ge 6 ] && t_title=$6
    [ "$#" -ge 7 ] && t_artist=$7
    [ "$#" -ge 8 ] && t_album=$8
    if [ "$kind" = track ]; then
        [ "$#" -ge 6 ] || t_title=$(state_last title)
        [ "$#" -ge 7 ] || t_artist=$(state_last artist)
        [ "$#" -ge 8 ] || t_album=$(state_last album)
    else
        t_title= t_artist= t_album=
    fi
    # A newline in a value would forge a line: guard, not trust.
    t_title=$(printf '%s' "${t_title:-}" | tr -d '\n\r')
    t_artist=$(printf '%s' "${t_artist:-}" | tr -d '\n\r')
    t_album=$(printf '%s' "${t_album:-}" | tr -d '\n\r')
    mkdir -p "$(dirname "$STREAMER_STATE")"
    tmp="$STREAMER_STATE.tmp"
    {
        printf 'mode=%s\nkind=%s\ntarget=%s\n' "$mode" "$kind" "$cur"
        [ -n "$provider" ] && printf 'provider=%s\n' "$provider"
        [ -n "$cur_vol" ] && printf 'volume=%s\n' "$cur_vol"
        if [ "$kind" = track ]; then
            [ -n "$t_title" ] && printf 'title=%s\n' "$t_title"
            [ -n "$t_artist" ] && printf 'artist=%s\n' "$t_artist"
            [ -n "$t_album" ] && printf 'album=%s\n' "$t_album"
        fi
        true
    } >"$tmp"
    mv -f "$tmp" "$STREAMER_STATE"
    sync
    # journald is volatile, so intent changes also go to the durable log.
    /usr/local/bin/streamer-bootlog "intent set: mode=$mode kind=$kind target=$cur${provider:+ provider=$provider}${cur_vol:+ volume=$cur_vol}${t_title:+ title=$t_title}"
}

# This session's play request, when the command was not given --save: the same
# key=value shape as the state record, on tmpfs, so a reboot cannot find it. The
# directory belongs to the daemon's account because streamer-play (User=pi) reads
# the file and unlinks it; the command that writes it re-ran under sudo.
request_play() { # request_play <kind> <target> [provider] [title] [artist] [album]
    dir=${STREAMER_PLAY_NOW%/*}
    mkdir -p "$dir" && chown "$STREAMER_USER:$STREAMER_GROUP" "$dir" && chmod 770 "$dir"
    r_target=$(printf '%s' "$2" | tr -d '\n\r')
    r_provider=$(printf '%s' "${3:-}" | tr -d '\n\r')
    r_title=$(printf '%s' "${4:-}" | tr -d '\n\r')
    r_artist=$(printf '%s' "${5:-}" | tr -d '\n\r')
    r_album=$(printf '%s' "${6:-}" | tr -d '\n\r')
    tmp="$STREAMER_PLAY_NOW.tmp"
    {
        printf 'kind=%s\ntarget=%s\n' "$1" "$r_target"
        [ -n "$r_provider" ] && printf 'provider=%s\n' "$r_provider"
        [ -n "$r_title" ] && printf 'title=%s\n' "$r_title"
        [ -n "$r_artist" ] && printf 'artist=%s\n' "$r_artist"
        [ -n "$r_album" ] && printf 'album=%s\n' "$r_album"
        true
    } >"$tmp"
    chmod 660 "$tmp"
    mv -f "$tmp" "$STREAMER_PLAY_NOW"
    sync
}

# One start of the play unit, whichever record it was asked for. When the command
# saved the choice instead of only asking for it, any older one-shot request goes
# first: the play unit reads that file in preference to the record.
start_play() { # the play-unit restart shared by the four play verbs
    [ "$do_save" = 1 ] && rm -f "$STREAMER_PLAY_NOW"
    systemctl restart streamer-play.service
}

playlist_target() { # playlist_target <name | provider:id>
    # Splits into pl_kind, pl_name, pl_provider. A bare name is a playlist cliamp
# saved on disk, loaded with `cliamp load`; provider:id is the spelling cliamp
# itself uses, and only provider.load can fetch it.
    pl_kind=playlist
    pl_name=$1
    pl_provider=
    case "$1" in
        local:*) pl_name=${1#local:} ;;
    esac
    for pr in ${STREAMER_PROVIDERS:-tidal qobuz spotify}; do
        case "$1" in
            "$pr":*) pl_provider=$pr; pl_kind=provider; pl_name=${1#"$pr":} ;;
        esac
    done
}

provider_target() { # provider_target <what> <provider:id>
    # Unlike a saved playlist name, a bare id means nothing until the service that
# minted it is named, so a missing prefix here is an error, not a local list.
    pt_id=$2 pt_provider=
    for pr in ${STREAMER_PROVIDERS:-tidal qobuz spotify}; do
        case "$2" in
            "$pr":*) pt_provider=$pr; pt_id=${2#"$pr":} ;;
        esac
    done
    [ -n "$pt_provider" ] || {
        echo "$1 target must be written <provider>:<id>, like tidal:1306459" >&2
        exit 2
    }
}

json_num() { # key's number, sign included: last hit wins, keys repeat
    printf '%s' "$1" |
        sed -n "s/.*\"$2\": *\(-\{0,1\}[0-9][0-9.]*\).*/\1/p" | tail -n 1
}

player_level() { # the level the player is actually at, empty if it said nothing
    lvl=$(json_num "$(cliamp status --json 2>/dev/null || true)" volume)
    case "$lvl" in ''|*[!0-9.-]*) return 0 ;; esac
    printf '%s\n' "$lvl"
}

save_level() { # record the level the player is actually at, after a change
    lvl=$(player_level)
    [ -n "$lvl" ] || return 0
    [ "$lvl" = "$cur_vol" ] && return 0
    save_state "$mode" "$kind" "$cur" "$provider" "$lvl"
}

# Last line wins per key, as in the boot script.
state_last() { sed -n "s/^$1=//p" "$STREAMER_STATE" 2>/dev/null | tail -n 1; }
mode=$(state_last mode)
kind=$(state_last kind)
cur=$(state_last target)
provider=$(state_last provider)
cur_vol=$(state_last volume)
title=$(state_last title)
mode=${mode:-last}
kind=${kind:-$STREAMER_START_KIND}
cur=${cur:-$STREAMER_START_TARGET}

cmd=${1:-status}
shift || true

if [ "$(id -u)" != 0 ] && needs_root "$cmd" "${1:-}" && [ -z "${STREAMER_SUDO:-}" ]; then
    # One attempt: with no sudoers drop-in the failure should land on the
# operation that needs root, not loop here.
    echo "$cmd needs root: re-running with sudo" >&2
    STREAMER_SUDO=1 exec sudo -E "$0" "$cmd" "$@"
fi

# `--save` decides whether a play command also records what plays next boot; it
# may sit anywhere among the arguments. Stripping it after the sudo pass means
# both passes see the same arguments and the verbs keep their ${1:?} usages.
do_save=0
case "$cmd" in
    station | playlist | album | track)
        i=$#
        while [ "$i" -gt 0 ]; do
            a=$1
            shift
            if [ "$a" = --save ]; then
                do_save=1
            else
                set -- "$@" "$a"
            fi
            i=$((i - 1))
        done
        ;;
esac

case "$cmd" in
    status)
        cliamp status
        printf 'boot mode:   %s\n' "$mode"
        printf 'boot target: %s %s%s%s\n' "$kind" "$cur" \
            "${provider:+ on $provider}" "${title:+ ($title)}"
        lvl="${cur_vol:-}"
        [ -n "$lvl" ] || lvl="$STREAMER_VOL_TARGET (default, never saved)"
        printf 'boot level:  %s dB\n' "$lvl"
        ;;
    last)
        # Everything the next boot needs, on one line.
        printf '%s %s %s%s%s%s\n' "$mode" "$kind" "$cur" \
            "${provider:+ on $provider}" "${title:+ ($title)}" "${cur_vol:+ at $cur_vol dB}"
        ;;
    mode)
        case "${1:-}" in
            last|stop) save_state "$1" "$kind" "$cur" ;;
            "")        ;;
            *)         echo "usage: streamer mode [last|stop]" >&2; exit 2 ;;
        esac
        printf 'boot mode: %s\n' "${1:-$mode}"
        ;;
    play)
        # Replay what the listener saved: any play request that was only for this
        # session is dropped along the way.
        rm -f "$STREAMER_PLAY_NOW" || true
        save_state last "$kind" "$cur"
        systemctl restart streamer-play.service
        ;;
    station)
        url=${1:?usage: streamer station <url> [--save]}
        if [ "$do_save" = 1 ]; then
            save_state last url "$url" ""
        else
            request_play url "$url"
        fi
        start_play
        ;;
    playlist)
        playlist_target "${1:?usage: streamer playlist <name> | <provider>:<id> [--save]}"
        if [ "$do_save" = 1 ]; then
            save_state last "$pl_kind" "$pl_name" "$pl_provider"
        else
            request_play "$pl_kind" "$pl_name" "$pl_provider"
        fi
        start_play
        ;;
    album)
        provider_target album "${1:?usage: streamer album <provider>:<id> [--save]}"
        if [ "$do_save" = 1 ]; then
            save_state last album "$pt_id" "$pt_provider"
        else
            request_play album "$pt_id" "$pt_provider"
        fi
        start_play
        ;;
    track)
        provider_target track "${1:?usage: streamer track <provider>:<id> [title] [artist] [album] [--save]}"
        # The strings only decide what "now playing" shows after the boot.
        if [ "$do_save" = 1 ]; then
            save_state last track "$pt_id" "$pt_provider" "$cur_vol" "${2:-}" "${3:-}" "${4:-}"
        else
            request_play track "$pt_id" "$pt_provider" "${2:-}" "${3:-}" "${4:-}"
        fi
        start_play
        ;;
    remember)
        # Next boot only, without touching playback: a tapped playlist already started
# the music, and `streamer playlist` on top would restart the boot sequence
# from the floor mid-track.
        # The level is captured with the source, read back from the player: the
        # Omarchy bar panel drives cliamp's dB directly, so a level moved there
        # reaches the record at this capture rather than never. A level at or
        # below the boot floor is a parked control, not a preference: then the
        # saved one carries on.
        lvl=$(player_level)
        if [ -n "$lvl" ] && ! awk -v l="$lvl" -v f="$STREAMER_VOL_FLOOR" \
            'BEGIN{ exit (l+0 <= f+0) ? 0 : 1 }'; then
            cur_vol=$lvl
        fi
        what=${1:?usage: streamer remember <station|playlist|album|track|mode> <target>}
        case "$what" in
            station)
                url=${2:?usage: streamer remember station <url>}
                save_state last url "$url" ""
                ;;
            playlist)
                playlist_target "${2:?usage: streamer remember playlist <name>}"
                save_state last "$pl_kind" "$pl_name" "$pl_provider"
                ;;
            album)
                provider_target album "${2:?usage: streamer remember album <provider>:<id>}"
                save_state last album "$pt_id" "$pt_provider"
                ;;
            track)
                provider_target track "${2:?usage: streamer remember track <provider>:<id> [title] [artist] [album]}"
                # Always pass the triple, empty included: a row tapped without strings must
# not inherit the last track's title.
                save_state last track "$pt_id" "$pt_provider" "$cur_vol" "${3:-}" "${4:-}" "${5:-}"
                ;;
            mode)
                case "${2:-}" in
                    last|stop) save_state "$2" "$kind" "$cur" ;;
                    *) echo "usage: streamer remember mode [last|stop]" >&2; exit 2 ;;
                esac
                ;;
            *) echo "usage: streamer remember <station|playlist|album|track|mode> <target>" >&2
               exit 2 ;;
        esac
        ;;
    stations)
        # The list belongs to the radio service, so this needs the network. grep, not a
# JSON parser: no jq on the image, and the body's line shape varies. "stream"
# quoted so "tracks_url" does not match.
        if out=$(curl -fsS --max-time 10 "$STREAMER_STATION_LIST" 2>/dev/null) && [ -n "$out" ]; then
            names=$(printf '%s' "$out" | grep -o '"name":"[^"]*"' | sed 's/^"name":"//; s/"$//')
            urls=$(printf '%s' "$out" | grep -o '"stream":"[^"]*"' | sed 's/^"stream":"//; s/"$//')
            if [ -n "$names" ] && [ -n "$urls" ]; then
                tmpd=$(mktemp -d)
                printf '%s\n' "$names" >"$tmpd/names"
                printf '%s\n' "$urls" >"$tmpd/urls"
                paste "$tmpd/names" "$tmpd/urls"
                rm -rf "$tmpd"
            else
                # Not the shape expected: show the body instead of hiding it.
                printf '%s\n' "$out" | tr ',' '\n' | sed -n '1,60p'
            fi
        else
            echo "could not read $STREAMER_STATION_LIST" >&2
        fi
        echo "then: streamer station <url> [--save]"
        ;;
    stop)
        cliamp stop || true
        save_state stop "$kind" "$cur"
        ;;
    pause|toggle|next|prev)
        cliamp "$cmd"
        ;;
    vol|volume)
        db=${1:?usage: streamer vol <dB>}
        case "$db" in -[0-9]*|[0-9]*) ;; *) echo "not a dB value: $db" >&2; exit 2 ;; esac
        cliamp volume "$db"
        # Read back from the player, not from the request: it has its own floor and
# ceiling, and what it settled at is what the next boot aims at. Not a timer.
        save_level
        ;;
    up|down)
        n=${1:-3}
        case "$n" in ''|*[!0-9.]) echo "not a dB amount: $n" >&2; exit 2 ;; esac
        sign=
        [ "$cmd" = down ] && sign=-
        cliamp remote call volume.adjust --params "{\"value\":$sign$n}" --wait >/dev/null
        save_level
        ;;
    reset)
        # /data goes back to the tree the build seeded the partition from, so a reset
# card and a fresh card are the same box. Costs the local music and the Tidal
# sign-in.
        if [ "${1:-}" != --yes ]; then
            echo "this removes everything on $STREAMER_DATA, the Tidal sign-in with it:" >&2
            ls -1A "$STREAMER_DATA" 2>/dev/null | sed 's/^/  /' >&2
            echo "to go ahead: streamer reset --yes" >&2
            exit 2
        fi
        # Stop the player first: it holds the IPC socket and the config directory open,
# and its exit handler writes to both.
        systemctl stop streamer-play.service streamer-cliamp.service
        # find, not a shell glob: a glob skips dotfiles and leaves half a stale state.
        find "$STREAMER_DATA" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
        cp -a "$STREAMER_SEED/." "$STREAMER_DATA/"
        # cp -a keeps the template's ownership; insurance against a hand-made template.
        chown -R "$STREAMER_USER:$STREAMER_GROUP" "$STREAMER_DATA"
        sync
        /usr/local/bin/streamer-bootlog \
            "factory reset: $STREAMER_DATA restored to the built-in template"
        systemctl restart streamer-cliamp.service streamer-play.service
        echo "$STREAMER_DATA is back to the state the card was built with"
        echo "it is playing the default station; sign in to Tidal again with: cliamp"
        ;;
    log)
        journalctl -u streamer-cliamp.service -u streamer-play.service -u streamer-http.service -b --no-pager
        ;;
    boots)
        # The record that survives a power cut; the journal covers only this boot.
        [ -f "$STREAMER_BOOTLOG" ] && tail -n 20 "$STREAMER_BOOTLOG" || echo "no boot log yet"
        ;;
    reload)
        systemctl restart streamer-cliamp.service streamer-play.service
        ;;
    audio)
        want=${1:-}
        case "$want" in
            "")
                sed -n '/# --- streamer audio begin ---/,/# --- streamer audio end ---/p' \
                    /boot/firmware/config.txt
                echo "switch with: streamer audio jack|dac"
                ;;
            jack|dac)
                frag=/etc/streamer/audio-$want.txt
                [ -f "$frag" ] || { echo "no fragment $frag" >&2; exit 1; }
                mount -o remount,rw /boot/firmware
                awk -v f="$frag" '
                    /^# --- streamer audio begin ---$/ {
                        print; while ((getline l < f) > 0) print l; skip = 1; next
                    }
                    /^# --- streamer audio end ---$/   { skip = 0; print; next }
                    !skip                              { print }
                ' /boot/firmware/config.txt >/boot/firmware/config.txt.new
                mv -f /boot/firmware/config.txt.new /boot/firmware/config.txt
                sync
                mount -o remount,ro /boot/firmware 2>/dev/null || true
                /usr/local/bin/streamer-bootlog "audio output set to $want, rebooting"
                echo "audio output is now $want; rebooting"
                systemctl --no-block reboot
                ;;
            *)
                echo "usage: streamer audio [jack|dac]" >&2; exit 2 ;;
        esac
        ;;
    rw)
        mount -o remount,rw /
        /usr/local/bin/streamer-bootlog "/ made writable"
        echo "/ is writable. Undo with: streamer ro"
        ;;
    ro)
        sync
        mount -o remount,ro /
        /usr/local/bin/streamer-bootlog "/ made read-only again"
        echo "/ is read-only"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "unknown command: $cmd" >&2
        usage >&2
        exit 2
        ;;
esac
