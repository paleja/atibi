#!/usr/bin/env python3
"""streamer - the appliance's control surface, typed over SSH or driven by the
LAN page. One verb per thing, and the verbs that decide do not overlap:

  play     what sounds now. Writes nothing to the card.
  boot     what plays next boot. Touches nothing that is playing.
  level    one number, the player's own dB, remembered as the player settled at
           it, never as the number that was asked for.

  streamer                      what plays now, and what plays next boot
  streamer now                  the row, the list it came from, the level
  streamer boots                the durable log, the one that survives a cut
  streamer log                  this boot's journal
  streamer stations             the built-in endpoints, as the service lists them
  streamer boot                 show the record
  streamer boot now             next boot = what is playing now
  streamer boot station <url>   ditto for a target typed out
  streamer boot playlist <name | provider:id>
  streamer boot album|track <provider>:<id> [title] [artist] [album]
  streamer boot on|off          resume on boot, or stay quiet after it
  streamer play                 play the source the record holds, now
  streamer play station <url>   play this stream now
  streamer play playlist <name | provider:id>
  streamer play album|track <provider>:<id> [title] [artist] [album]
  streamer resume|pause|toggle|next|prev|stop
  streamer level <dB> | now | up <N> | down <N>
  streamer restart              the saved target again, from the floor, with the ramp
  streamer reload               the daemon and playback
  streamer audio [jack|dac]     show or switch the output, then reboot
  streamer rw | ro              make / writable, then read-only again
  streamer reset --yes          /data back to what the card was built with

`stop` stops: staying quiet after the next boot is a separate decision, said
with `boot off`. Root comes back on its own for the verbs that need it - the
image ships a passwordless sudoers drop-in, and STREAMER_SUDO marks the second
pass - and STREAMER_CONF is the knob file the harness points elsewhere.
"""

import argparse
import json
import os
import subprocess
import sys
import urllib.request

from streamer import num, own
from streamer.app import Appliance
from streamer.conf import KnobError
from streamer.ipc import IpcError
from streamer.intent import (NoTarget, parse_target, record_level, record_mode,
                             record_now, record_target)
from streamer.player import PlayerError

CONF_PATH = "/etc/streamer.conf"
AUDIO_BEGIN = "# --- streamer audio begin ---"
AUDIO_END = "# --- streamer audio end ---"
BOOT_UNITS = ("streamer-cliamp.service", "streamer-play.service")

# The transport verbs, spelled as the operations they send. `stop` stops and
# says nothing about the next boot: staying quiet after a reboot is `boot off`.
TRANSPORT = {"resume": "play", "pause": "pause", "toggle": "toggle",
             "next": "next", "prev": "prev", "stop": "stop"}

# The verbs whose work is a system unit, the read-only root or /boot: they re-run
# once under sudo, which the image's passwordless sudoers drop-in allows.
NEEDS_ROOT = ("restart", "reload", "reset", "rw", "ro")


def splice_config(text, fragment):
    """Replace only what sits between the two audio markers, so switching the
    output is idempotent and a hand-added line elsewhere in config.txt survives
    every switch."""
    out, skipping = [], False
    for line in text.splitlines(True):
        if line.rstrip("\r\n") == AUDIO_BEGIN:
            out.append(line)
            out.extend(fragment)
            skipping = True
            continue
        if line.rstrip("\r\n") == AUDIO_END:
            skipping = False
            out.append(line)
            continue
        if not skipping:
            out.append(line)
    return "".join(out)


class Show:
    def __init__(self, app, out):
        self.app = app
        self.out = out

    def now(self):
        app = self.app
        try:
            snap = app.player.snapshot()
        except IpcError as exc:
            # The player not answering is worth saying, and the record is still
            # worth showing: a daemon that has not come up is not a reason to
            # hide what the next boot would load.
            self.out.write("player: %s\n" % exc)
            return
        row = snap.get("track") if isinstance(snap.get("track"), dict) else {}
        level = app.player.level()
        self.out.write("state:   %s\n" % snap.get("state", "unknown"))
        if row:
            self.out.write("track:   %s - %s (%s)\n" % (
                row.get("artist", ""), row.get("title", ""), row.get("album", "")))
            self.out.write("row:     %s of %s in %s\n" % (
                int(snap.get("index", 0)) + 1, snap.get("total", "?"),
                snap.get("playlist", "one track")))
        if snap.get("position") is not None:
            self.out.write("position: %d of %d s\n" % (
                int(snap["position"]), int(snap.get("duration") or 0)))
        self.out.write("level:   %s dB\n" % (num(level) if level is not None
                                             else "unknown"))

    def boots(self):
        try:
            with open(self.app.conf.bootlog, encoding="utf-8") as handle:
                lines = handle.read().splitlines()
        except OSError:
            self.out.write("no boot log yet\n")
            return
        for line in lines[-20:]:
            self.out.write("%s\n" % line)

    def stations(self):
        """Fetched, never duplicated in the image, so the two cannot drift.
        The pairing is what the next command wants: name, then its stream."""
        try:
            with urllib.request.urlopen(self.app.conf.station_list,
                                        timeout=10) as answer:
                body = answer.read().decode("utf-8", "replace")
        except (OSError, ValueError) as exc:
            self.out.write("could not read %s: %s\n" % (self.app.conf.station_list,
                                                        exc))
            return
        try:
            entries = json.loads(body).get("stations", [])
        except ValueError:
            entries = []
        rows = [(entry.get("name", ""), entry["stream"])
                for entry in entries if isinstance(entry, dict) and entry.get("stream")]
        if not rows:
            # Not the shape expected: show the body rather than hide it.
            for line in body.replace(",", ",\n").splitlines()[:60]:
                self.out.write("  %s\n" % line)
            return
        for name, stream in rows:
            self.out.write("%s\t%s\n" % (name, stream))
        self.out.write("then: streamer play station <url>"
                       " | streamer boot station <url>\n")


class Play:
    """What sounds now. Writes nothing to the card: the next boot is a separate
    decision, taken in the boot tab or by `streamer boot`.

    Four shapes of target, and one path to the daemon each: the words a person
    types are turned into the record's field names by `parse_target`, and the
    player knows which operation each kind needs. Nothing here reads or writes
    the boot record, so a play cannot change what a reboot would load.
    """

    def __init__(self, app, out):
        self.app = app
        self.out = out

    def target(self, what, target, strings=()):
        fields = parse_target(what, target, self.app.conf.providers)
        self.start(fields, strings)
        return 0

    def start(self, fields, strings=()):
        app = self.app
        app.player.start(fields["kind"], fields["target"], fields["provider"],
                         tuple(strings))
        app.bootlog.note("played: %s %s%s" % (
            fields["kind"], fields["target"],
            " on %s" % fields["provider"] if fields["provider"] else ""))
        self.out.write("playing: %s %s%s\n" % (
            fields["kind"], fields["target"],
            " on %s" % fields["provider"] if fields["provider"] else ""))

    def last(self):
        """The source the record holds, at the level the player is already at:
        what a boot would have played, played now. No floor and no ramp - a
        ramp is only what a boot does before anyone is listening.
        """
        fields = self.app.read_record()
        if fields["mode"] != "last":
            self.out.write("boot mode is stop: %s %s is kept but not played\n"
                           % (fields["kind"], fields["target"]))
            self.out.write("say so first: streamer boot on\n")
            return 1
        self.start({"kind": fields["kind"], "target": fields["target"],
                    "provider": fields.get("provider", "")},
                   (fields.get("title", ""), fields.get("artist", ""),
                    fields.get("album", "")))
        return 0

    def transport(self, operation):
        """pause, resume, toggle, next, prev, stop: the transport, nothing else.

        `stop` stops and says nothing about the next boot; staying quiet after
        a reboot is `streamer boot off`, said out loud.
        """
        self.app.player.transport(operation)
        return 0


class Level:
    """One control surface, cliamp's own dB.

    The number is read back after it is set, and the record is written through
    the same capture the page uses: cliamp clamps to the volume_min in
    /data/cliamp/config.toml and to +6, and what it settled at is what the
    next boot aims at. A level at or below the boot floor is a parked control,
    so it is not remembered - the floor is the last word by design.
    """

    def __init__(self, app, out):
        self.app = app
        self.out = out

    def show(self, value):
        level = self.app.player.level()
        self.out.write("level: %s dB\n" % (num(level) if level is not None
                                          else "unknown"))
        return 0

    def set(self, value, amount):
        app = self.app
        current = app.player.level()
        if value in ("up", "down"):
            if amount is None:
                raise ValueError("usage: streamer level up|down <dB>")
            step = float(amount) * (1 if value == "up" else -1)
            if current is None:
                raise ValueError("the level is unreadable, so it cannot be stepped")
            app.player.adjust_level(step)
        else:
            app.player.set_level(float(value))
        settled = app.player.level()
        remembered = record_level(app)
        self.out.write("level: %s dB\n" % (num(settled) if settled is not None
                                          else "unknown"))
        if remembered is None:
            self.out.write("not remembered: at or below the %s dB boot floor, so the"
                           " next boot comes up at the default %s dB\n"
                           % (num(app.conf.vol_floor), num(app.conf.vol_target)))
        return 0

    def now(self):
        return self.show(None)


class NextBoot:
    """What plays next boot, and how loud: the only writer of the record.

    One rule the class exists for: writing the record never touches playback.
    A tapped playlist has already started its music, and a start on top of it
    would mean a second start and a trip back to the floor mid-track.
    """

    def __init__(self, app, out):
        self.app = app
        self.out = out

    def show(self):
        fields = self.app.read_record()
        source = "%s %s" % (fields["kind"], fields["target"])
        if fields.get("provider"):
            source += " on %s" % fields["provider"]
        if fields.get("title"):
            source += " (%s)" % fields["title"]
        level = fields.get("volume")
        if level is None:
            level = "%s (default, never saved)" % num(self.app.conf.vol_target)
        self.out.write("mode:    %s\n" % fields["mode"])
        self.out.write("boot:    %s\n" % source)
        self.out.write("level:   %s dB\n" % level)
        return 0

    def now(self):
        try:
            saved = record_now(self.app)
        except NoTarget as exc:
            self.out.write("%s\n" % exc)
            return 1
        self.out.write("next boot: %s %s%s\n" % (
            saved["kind"], saved["target"],
            " on %s" % saved["provider"] if saved.get("provider") else ""))
        return 0

    def mode(self, resume):
        saved = record_mode(self.app, resume == "on")
        self.out.write("boot mode: %s\n" % saved["mode"])
        return 0

    def target(self, what, target, strings=()):
        fields = parse_target(what, target, self.app.conf.providers)
        if fields["kind"] == "track":
            # title, artist, album decide what "now playing" shows for a row
            # rebuilt from an id, and they are named even when empty: a track
            # chosen without strings must not inherit the track before it.
            fields["title"], fields["artist"], fields["album"] = (
                list(strings) + ["", "", ""])[:3]
        saved = record_target(self.app, fields)
        self.out.write("next boot: %s %s%s\n" % (
            saved["kind"], saved["target"],
            " on %s" % saved["provider"] if saved.get("provider") else ""))
        return 0


class Box:
    """The box itself: units, the read-only root, /data. All of it needs the
    root the sudo pass brings, except showing the audio block."""

    def __init__(self, app, out):
        self.app = app
        self.out = out

    def systemctl(self, *args):
        subprocess.run(("systemctl",) + args, check=True)

    def restart(self):
        """The saved target again, from the floor and with the ramp: that is the
        boot path, so it goes through the unit that owns the floor."""
        self.systemctl("restart", "streamer-play.service")

    def reload(self):
        self.systemctl("restart", *BOOT_UNITS)

    def rw(self):
        subprocess.run(("mount", "-o", "remount,rw", "/"), check=True)
        self.app.bootlog.note("/ made writable")
        self.out.write("/ is writable. Undo with: streamer ro\n")

    def ro(self):
        os.sync()
        subprocess.run(("mount", "-o", "remount,ro", "/"), check=True)
        self.app.bootlog.note("/ made read-only again")
        self.out.write("/ is read-only\n")

    def audio(self, want):
        path = "/boot/firmware/config.txt"
        try:
            with open(path, encoding="utf-8") as handle:
                text = handle.read()
        except OSError as exc:
            raise PlayerError("cannot read %s: %s" % (path, exc)) from exc
        if want is None:
            inside = False
            for line in text.splitlines():
                inside = inside or line == AUDIO_BEGIN
                if inside:
                    self.out.write("%s\n" % line)
                if line == AUDIO_END:
                    break
            self.out.write("switch with: streamer audio jack|dac\n")
            return 0
        try:
            with open("/etc/streamer/audio-%s.txt" % want,
                      encoding="utf-8") as handle:
                fragment = ["%s\n" % line for line in handle.read().splitlines()]
        except OSError as exc:
            raise PlayerError("no fragment for %s: %s" % (want, exc)) from exc
        subprocess.run(("mount", "-o", "remount,rw", "/boot/firmware"), check=True)
        with open("%s.new" % path, "w", encoding="utf-8") as handle:
            handle.write(splice_config(text, fragment))
        os.replace("%s.new" % path, path)
        os.sync()
        subprocess.run(("mount", "-o", "remount,ro", "/boot/firmware"),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       check=False)
        self.app.bootlog.note("audio output set to %s, rebooting" % want)
        self.out.write("audio output is now %s; rebooting\n" % want)
        self.systemctl("--no-block", "reboot")
        return 0

    def reset(self, yes):
        """/data goes back to the tree the build seeded the partition with, so a
        reset card and a fresh card are the same box."""
        if not yes:
            self.out.write("this removes everything on %s, the Tidal sign-in with"
                           " it:\n" % self.app.conf.data)
            try:
                for name in sorted(os.listdir(self.app.conf.data)):
                    self.out.write("  %s\n" % name)
            except OSError:
                pass
            self.out.write("to go ahead: streamer reset --yes\n")
            return 2
        # Stop the player first: it holds the IPC socket and its config directory
        # open, and its exit handler writes to both.
        self.systemctl("stop", *BOOT_UNITS)
        for name in os.listdir(self.app.conf.data):
            subprocess.run(("rm", "-rf", os.path.join(self.app.conf.data, name)),
                           check=True)
        subprocess.run(("cp", "-a", "%s/." % self.app.conf.seed,
                        self.app.conf.data), check=True)
        # cp -a keeps the template's ownership; this is insurance against a
        # hand-made template, the same insurance the build's copy cannot have.
        self._chown(self.app.conf.data)
        os.sync()
        self.app.bootlog.note("factory reset: %s restored to the built-in template"
                              % self.app.conf.data)
        self.systemctl("restart", *BOOT_UNITS)
        self.out.write("%s is back to the state the card was built with\n"
                       % self.app.conf.data)
        self.out.write("it is playing the default station; sign in to Tidal again"
                       " with: cliamp\n")
        return 0

    def _chown(self, root):
        paths = [root]
        for base, dirs, files in os.walk(root):
            paths.extend(os.path.join(base, name) for name in dirs + files)
        for path in paths:
            own(path, self.app.conf.user, self.app.conf.group)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="streamer", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    verbs = parser.add_subparsers(dest="command", metavar="COMMAND")

    def add(name, help_text, **kwargs):
        return verbs.add_parser(name, help=help_text, **kwargs)

    add("status", "what plays now and what plays next boot")
    add("now", "what is playing now")
    add("boots", "the durable boot log")
    add("log", "this boot's journal")
    add("stations", "the built-in radio endpoints")
    for name, help_text in (("resume", "resume the transport"),
                            ("pause", "pause the transport"),
                            ("toggle", "pause or resume"),
                            ("next", "skip forward"),
                            ("prev", "skip back"),
                            ("stop", "stop: and nothing about the next boot")):
        add(name, help_text)
    add("restart", "the saved target again, from the floor, with the ramp")
    add("reload", "the daemon and playback")
    add("rw", "make / writable")
    add("ro", "make / read-only again")

    boot = add("boot", "what plays next boot")
    boot.add_argument("what", nargs="?", default=None, metavar="WHAT",
                      help="now | on | off | station | playlist | album | track")
    boot.add_argument("target", nargs="?", default=None, metavar="TARGET",
                      help="the stream, list, album or track")
    boot.add_argument("strings", nargs="*", default=[], metavar="STRING",
                      help="title, artist, album: what a track row shows once playing")

    play = add("play", "play it now; the next boot is unchanged")
    play.add_argument("what", nargs="?", default=None, metavar="WHAT",
                      choices=("station", "playlist", "album", "track"),
                      help="what to play; empty plays the source the record holds")
    play.add_argument("target", nargs="?", default=None, metavar="TARGET")
    play.add_argument("strings", nargs="*", default=[], metavar="STRING",
                      help="title, artist, album: what the row shows once playing")

    level = add("level", "cliamp's own dB, one control")
    level.add_argument("value", nargs="?", default=None, metavar="VALUE",
                       help="an absolute dB, now, up or down")
    level.add_argument("amount", nargs="?", default=None, metavar="dB")

    audio = add("audio", "show or switch the output")
    audio.add_argument("want", nargs="?", default=None, choices=("jack", "dac"))

    reset = add("reset", "/data back to what the build seeded")
    reset.add_argument("--yes", action="store_true")
    return parser


def main(argv=None, out=None, conf_path=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    out = out or sys.stdout
    parser = build_parser()
    args = parser.parse_args(argv or ["status"])
    command = args.command

    if needs_root(command, getattr(args, "want", None)) and os.geteuid() != 0:
        if not os.environ.get("STREAMER_SUDO"):
            sys.stderr.write("%s needs root: re-running with sudo\n" % command)
            env = dict(os.environ, STREAMER_SUDO="1")
            os.execvpe("sudo", ["sudo", "-E", sys.argv[0]] + argv, env)

    app = Appliance(conf_path)
    show = Show(app, out)
    play = Play(app, out)
    level = Level(app, out)
    boot = NextBoot(app, out)
    box = Box(app, out)

    if command == "status":
        show.now()
        return boot.show()
    if command in ("now", "boots", "stations"):
        return getattr(show, command)() or 0
    if command == "boot":
        if args.what is None:
            return boot.show()
        if args.what == "now":
            return boot.now()
        if args.what in ("on", "off"):
            return boot.mode(args.what)
        return boot.target(args.what, args.target, args.strings)
    if command == "play":
        if args.what is None:
            return play.last()
        return play.target(args.what, args.target, args.strings)
    if command == "level":
        if args.value in (None, "now"):
            return level.now()
        return level.set(args.value, args.amount)
    if command == "audio":
        return box.audio(args.want) or 0
    if command == "reset":
        return box.reset(args.yes) or 0
    if command in ("restart", "reload", "rw", "ro"):
        return getattr(box, command)() or 0
    if command in TRANSPORT:
        return play.transport(TRANSPORT[command])
    if command == "log":
        subprocess.run(("journalctl", "-u", "streamer-cliamp.service",
                        "-u", "streamer-play.service",
                        "-u", "streamer-http.service", "-b", "--no-pager"))
        return 0
    parser.print_help(out)
    sys.stderr.write("unknown command: %s\n" % command)
    return 2


def needs_root(command, argument):
    if command == "audio":
        return bool(argument)
    return command in NEEDS_ROOT


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (PlayerError, IpcError, NoTarget, KnobError, ValueError,
            subprocess.CalledProcessError) as exc:
        sys.stderr.write("%s\n" % exc)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
