#!/bin/sh
# Run by atibi-static.service before NetworkManager starts: hand NM the profile
# the appliance saved, so the wired interface comes up with the address it had
# instead of waiting for a DHCP server to give one. No file: inert, DHCP answers
# for it as it always did.
set -eu

. /etc/atibi.conf

# A knob the build stopped shipping is a broken install, said rather than
# guessed at: the silent default would put the profile somewhere nobody looks.
file="${ATIBI_STATIC:-}"
if [ -z "$file" ]; then
    echo "atibi.conf has no ATIBI_STATIC" >&2
    exit 1
fi
[ -f "$file" ] || exit 0
target=/run/NetworkManager/system-connections/atibi.nmconnection

# A hand edit that broke the file would otherwise leave NM with a profile it
# refuses in silence: say so, and stay on DHCP.
if ! grep -q '^\[connection\]' "$file"; then
    echo "$file is not a profile NM reads: leaving the boot to DHCP" >&2
    exit 0
fi

# 600: NM calls any other mode in system-connections insecure and ignores it.
mkdir -p "$(dirname "$target")"
install -m 600 "$file" "$target"
