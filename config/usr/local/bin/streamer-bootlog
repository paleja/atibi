#!/bin/sh
# streamer-bootlog <one line> - one durable line about this boot.
# journald is volatile on this box, so this file on /data is the only record
# a boot leaves behind, kept to the last STREAMER_BOOTLOG_KEEP lines.
set -eu

. /etc/streamer.conf

umask 022
dir=$(dirname "$STREAMER_BOOTLOG")
mkdir -p "$dir" 2>/dev/null || true

# Two identities write this: the units as STREAMER_USER, and a `streamer`
# typed over SSH as root. Whichever made the file closes it to the other, so
# the writer hands the file back to the boot user when it can.
if [ -e "$STREAMER_BOOTLOG" ] && [ ! -w "$STREAMER_BOOTLOG" ]; then
    tmp="$STREAMER_BOOTLOG.tmp.$$"
    tail -n "$STREAMER_BOOTLOG_KEEP" "$STREAMER_BOOTLOG" >"$tmp" 2>/dev/null &&
        mv -f "$tmp" "$STREAMER_BOOTLOG" || rm -f "$tmp"
fi

# Append and trim are one operation, under a lock: a boot that keeps failing
# runs this again every RestartSec, and an unlocked trim renames a fresh file
# over a log another writer is still appending to.
boot_log() {
    flock 9 || return 0
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" \
        >>"$STREAMER_BOOTLOG" 2>/dev/null || return 0
    lines=$(wc -l <"$STREAMER_BOOTLOG" 2>/dev/null || echo 0)
    case "$lines" in ''|*[!0-9]*) lines=0 ;; esac
    if [ "$lines" -gt "$STREAMER_BOOTLOG_KEEP" ]; then
        tmp="$STREAMER_BOOTLOG.tmp.$$"
        tail -n "$STREAMER_BOOTLOG_KEEP" "$STREAMER_BOOTLOG" >"$tmp" 2>/dev/null &&
            mv -f "$tmp" "$STREAMER_BOOTLOG" || rm -f "$tmp"
    fi
}
# The silence comes first: written as `9>>... 2>/dev/null`, the shell's own
# cannot-open message reached the journal, 210 lines of it on the card. A
# line that cannot be written is dropped.
(boot_log "$*") 2>/dev/null 9>>"$STREAMER_BOOTLOG" || true
chown "$STREAMER_USER:$STREAMER_GROUP" "$STREAMER_BOOTLOG" 2>/dev/null || true
