#!/bin/sh
# streamer-save - record where playback has got to, so the next boot can pick
# it up. Run by streamer-save.timer. A hard power cut costs at most the time
# since the last save.
#
# Three things are kept in one small file: the position and index of a finite
# playlist, and the volume the session was at. The volume matters because the
# boot sequence always starts at the floor in /etc/streamer.conf and ramps up
# from there, and the level it ramps towards is the one saved here rather than
# a fixed number. See docs/PRD.md §6.4 and §8.3.
set -eu

. /etc/streamer.conf

json=$(cliamp status --json 2>/dev/null) || exit 0
[ -n "$json" ] || exit 0

pick() { # pick <key> : one number, sign included
    printf '%s' "$json" | sed -n "s/.*\"$1\":\(-\{0,1\}[0-9][0-9.]*\).*/\1/p"
}

state=$(printf '%s' "$json" | sed -n 's/.*"state":"\([a-z]*\)".*/\1/p')
vol=$(pick volume)
pos=$(pick position)
idx=$(pick index)

# Position and index only mean something while something is playing: with an
# empty queue cliamp reports index -1, and keeping the last real values is what
# makes a crash in the middle of an album come back in the middle of it.
prev_pos=
prev_idx=
if [ -f "$STREAMER_PROGRESS" ]; then
    prev_pos=$(sed -n 's/^position=//p' "$STREAMER_PROGRESS" 2>/dev/null || true)
    prev_idx=$(sed -n 's/^index=//p' "$STREAMER_PROGRESS" 2>/dev/null || true)
fi
if [ "$state" != playing ]; then
    pos=$prev_pos
    idx=$prev_idx
fi

# What is already on disk is the fallback for anything this run could not read,
# so a station that briefly goes silent does not wipe the middle of an album.
case "$vol" in ''|*[!0-9.-]*) vol= ;; esac
if [ -n "$pos" ]; then
    pos=${pos%%.*}
else
    pos=$prev_pos
fi
if [ -z "$idx" ]; then
    idx=$prev_idx
    [ -n "$idx" ] || idx=-1
fi
case "$pos" in ''|*[!0-9]*) pos= ;; esac
case "$idx" in ''|*[!0-9-]*) idx=-1 ;; esac
[ -n "$pos$idx$vol" ] || exit 0

mkdir -p "$(dirname "$STREAMER_PROGRESS")"
tmp="$STREAMER_PROGRESS.tmp"
{
    [ -n "$pos" ] && printf 'position=%s\n' "$pos"
    [ -n "$idx" ] && printf 'index=%s\n' "$idx"
    [ -n "$vol" ] && printf 'volume=%s\n' "$vol"
    true
} >"$tmp"
mv -f "$tmp" "$STREAMER_PROGRESS"
